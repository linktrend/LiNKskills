tools/ltr/src/token.json
tools/ltr/src/credentials.json
tools/ltr/src/__pycache__/
tools/ltr/src/*.log
tools/ltr/src/venv/

# Fortress security storage
tools/vault/data/*.bin
**/token.json

# Archived Logic Engine runtime artifacts (non-source-of-truth; subsystem retired 2026-07-14, see docs/adr/0001)
archive/logic-engine-2026-07-14/logic-engine/runtime/*.json
archive/logic-engine-2026-07-14/logic-engine/runtime/*.jsonl
archive/logic-engine-2026-07-14/logic-engine/runtime/*.log

