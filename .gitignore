# Ignore local task state and raw traces
.workdir/
**/trace.log
**/state.json
**/state.jsonl

# Ignore system-specific files
.DS_Store
__pycache__/
*.pyc
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml

# Keep execution_ledger.jsonl tracked: validator requires the file at repo root
