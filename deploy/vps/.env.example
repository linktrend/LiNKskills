# LiNKskills VPS environment (non-secret template)

# Copy to .env locally. Never commit real secret values.
# Prefer GSM secret *names*; render with ./render-env-from-gsm.sh
# Service contract: docs/deploy/GATEWAY-MCP-SERVICE-DEFINITION.md
# Env names must match runtime parsers in:
#   packages/gateway/linkskills_gateway/paci_authenticator.py
#   packages/client/linkskills_client/paci_token_client.py
#   packages/gateway/linkskills_gateway/ops.py

LINKSKILLS_ENV=stage
LINKSKILLS_REPO_ROOT=/opt/LiNKskills

# ---------------------------------------------------------------------------
# Gateway / MCP process
# ---------------------------------------------------------------------------
LINKSKILLS_GATEWAY_HOST=127.0.0.1
LINKSKILLS_GATEWAY_PORT=8787
LINKSKILLS_AUTH_MODE=production
# module.path:attr — presence required for production /ready (do not put secrets here)
LINKSKILLS_PLATFORM_AUTHENTICATOR=
LINKSKILLS_DRAIN=0
LINKSKILLS_SHUTDOWN_TIMEOUT_S=30
LINKSKILLS_GATEWAY_DURABLE=0
# production/stage MUST be postgres (LINKSKILLS_ENV=stage|prod implies postgres).
# memory/sqlite are local-test only — never the silent default in stage/prod.
LINKSKILLS_GATEWAY_STORE=postgres
LINKSKILLS_STATE_DIR=
# Store reachability + migration probe on /ready (always on for stage/prod postgres).
LINKSKILLS_STORE_PROBE=1
LINKSKILLS_STORE_URL=
# Render SecretRef / GSM into a concrete DSN before process start (never commit secrets).
LINKSKILLS_DATABASE_URL=
LINKSKILLS_POSTGRES_URL=

# ---------------------------------------------------------------------------
# PACI / Platform auth (names + public URLs only)
# Audience for Skills resource server: lskills-api
# Resource-server env: paci_authenticator.py
# Client/token env: paci_token_client.py
# ---------------------------------------------------------------------------
LINKSKILLS_PACI_ISSUER=
LINKSKILLS_PACI_JWKS_URI=
LINKSKILLS_PACI_AUDIENCE=lskills-api
LINKSKILLS_PACI_REQUIRED_SERVICE_SCOPES=lskills
LINKSKILLS_PACI_INTROSPECTION_URL=
LINKSKILLS_PACI_INTROSPECTION_CLIENT_ID=
LINKSKILLS_PACI_CLIENT_ID=
LINKSKILLS_PACI_TOKEN_ENDPOINT=
# Absolute path to SecretRef-injected ES256 private key PEM (never inline PEM)
LINKSKILLS_PACI_CLIENT_PRIVATE_KEY_FILE=
LINKSKILLS_PACI_CLIENT_KID=
LINKSKILLS_PACI_SCOPE=
LINKSKILLS_PACI_RESOURCE_AUDIENCE=
LINKSKILLS_CANARY=0
LINKSKILLS_CANARY_AUTHORIZATION_SECRET_NAME=
# Legacy local-test alias only — not the primary PACI canary path
GATEWAY_TOKEN_SECRET_NAME=

# ---------------------------------------------------------------------------
# Shared platform Supabase (stage pair shown; use PROD_* on production hosts)
# ---------------------------------------------------------------------------
LINKTREND_PLATFORM_STAGE_SUPABASE_URL=
LINKTREND_PLATFORM_STAGE_SUPABASE_SECRET_KEY_SECRET_NAME=LINKTREND_PLATFORM_STAGE_SUPABASE_SECRET_KEY

# Optional prod pair
# LINKTREND_PLATFORM_PROD_SUPABASE_URL=
# LINKTREND_PLATFORM_PROD_SUPABASE_SECRET_KEY_SECRET_NAME=LINKTREND_PLATFORM_PROD_SUPABASE_SECRET_KEY

# Which env the telemetry writer / flush script targets
LIBRARIAN_TARGET_ENV=stage

# Eval receipt sealing (GSM name only)
LINKSKILLS_EVAL_RUNNER_ISSUER_KEY_SECRET_NAME=

GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/google/linktrend-gsm.json
