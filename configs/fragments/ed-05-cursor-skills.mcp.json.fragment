{
  "mcpServers": {
    "linkskills-ed05-cursor": {
      "command": "python3",
      "args": ["-m", "linkskills_mcp.paci_stdio_proxy"],
      "disabled": true,
      "env": {
        "PYTHONPATH": "packages/gateway:packages/mcp_server:packages/client:packages/librarian_domain:packages/eval_runner:packages/tool_runtime:packages/contracts:packages/core:.",
        "GATEWAY_URL": "https://skills.test.linktrend.invalid/provider-v2",
        "LINKSKILLS_MCP_UPSTREAM": "http",
        "LINKSKILLS_AUTH_MODE": "production",
        "LINKSKILLS_PACI_TOKEN_ENDPOINT": "https://auth.test.linkplatform.invalid/oauth/token",
        "LINKSKILLS_PACI_SCOPE": "lskills",
        "LINKSKILLS_PACI_RESOURCE_AUDIENCE": "lskills-api",
        "LINKSKILLS_PACI_CLIENT_PRIVATE_KEY_FILE": "REPLACE_WITH_SECRETREF_FILE_PATH_TO_ES256_PRIVATE_KEY_PEM",
        "LINKSKILLS_PACI_CLIENT_ID": "REPLACE_WITH_SKILLS_ONLY_CLIENT_ID",
        "LINKSKILLS_PACI_CLIENT_KID": "REPLACE_WITH_CLIENT_JWKS_KID_UUID"
      }
    }
  },
  "_comment": "ED-05 Cursor owner fragment. disabled=true. No secrets. Envelope platform.auth-token-envelope/0.1.0. Audience lskills-api. Do not reuse Brain/OpenClaw credentials. Do not merge into ~/.cursor/mcp.json. Exact pins: configs/consumer-activation/ed-05-cursor-owner-packet.json. live_apply=false. global_cursor_mutation=false.",
  "ed05": {
    "packetId": "ed-05-cursor",
    "disabledByDefault": true,
    "liveApply": false,
    "allowlist": [
      "git-safeguard@1.1.0",
      "persistent-qa@1.0.0",
      "repository-manager@1.0.0",
      "skill-template@1.2.0",
      "tool-architect@1.0.0"
    ]
  }
}
