{
  "mcpServers": {
    "linkskills-canary": {
      "command": "python3",
      "args": [
        "-m",
        "linkskills_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "packages/gateway:packages/mcp_server:packages/client:packages/librarian_domain:packages/eval_runner:packages/contracts:.",
        "GATEWAY_URL": "http://127.0.0.1:8787",
        "LINKSKILLS_CANARY": "1"
      },
      "disabled": false
    }
  },
  "_comment": "Project-scoped Cursor MCP fragment for LiNKskills canary. NO secrets. Point GATEWAY_URL at a local gateway. Do not merge into ~/.cursor/mcp.json without the coordinated Cursor maintenance gate."
}
