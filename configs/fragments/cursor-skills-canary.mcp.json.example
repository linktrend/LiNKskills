{
  "mcpServers": {
    "linkskills-canary": {
      "command": "python3",
      "args": [
        "-m",
        "linkskills_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "packages/gateway:packages/mcp_server:packages/client:packages/librarian_domain:packages/eval_runner:packages/tool_runtime:packages/contracts:packages/core:.",
        "GATEWAY_URL": "http://127.0.0.1:8787",
        "LINKSKILLS_CANARY": "1",
        "LINKSKILLS_AUTH_MODE": "production",
        "LINKSKILLS_PLATFORM_AUTHENTICATOR": "REPLACE_WITH_PLATFORM_APPROVED_AUTHENTICATOR_MODULE:factory",
        "LINKSKILLS_CANARY_AUTHORIZATION": "REPLACE_WITH_PLATFORM_SIGNED_BEARER"
      },
      "disabled": false
    }
  },
  "_comment": "Project-scoped Cursor MCP fragment for LiNKskills canary. NO secrets. LINKSKILLS_CANARY requires production cryptographic auth (Platform-approved authenticator via LINKSKILLS_PLATFORM_AUTHENTICATOR) and a signed bearer in LINKSKILLS_CANARY_AUTHORIZATION. Unsigned platform.<base64url(JSON)> and LINKSKILLS_AUTH_MODE=local-test are forbidden for canary. Do not merge into ~/.cursor/mcp.json without the coordinated Cursor maintenance gate. Do not start the multi-day canary from this fragment alone."
}
