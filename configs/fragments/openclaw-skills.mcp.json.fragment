{
  "contract_version": "0.2",
  "fragment_id": "openclaw-skills-mcp",
  "owner": "OpenClaw Prime (host application); LiNKskills authors contract only",
  "purpose": "Contract fragment describing the Skills MCP surface for OpenClaw integration. Conformance only in this repo — no OpenClaw mutation.",
  "mcp": {
    "server_name": "linkskills",
    "transport": "stdio",
    "command": "python3",
    "args": ["-m", "linkskills_mcp.server"],
    "env": {
      "PYTHONPATH": "packages/gateway:packages/mcp_server:packages/client:packages/librarian_domain:packages/eval_runner:packages/tool_runtime:packages/contracts:packages/core:.",
      "GATEWAY_URL": "http://127.0.0.1:8787"
    }
  },
  "operations": [
    "skills_list",
    "skills_search",
    "skills_describe",
    "skills_fragment_get",
    "skills_release_get",
    "skills_run_start",
    "skills_run_update",
    "skills_run_complete",
    "skills_run_fail",
    "skills_tool_resolve",
    "skills_tool_invoke",
    "skills_input_validate",
    "skills_output_validate",
    "skills_feedback_submit",
    "skills_trace_candidate_submit"
  ],
  "auth": {
    "issuer": "LiNKplatform",
    "claim_contract": "platform.auth-claims/1.0.0",
    "platform_contracts_package": "0.2.1",
    "schema_bytes_sha256": "b0397cdf34e76ab0986c6d223ecb6c3c66d619ea59557f78cd45c0c015ff50fb",
    "content_hash": "6bf49618d846662976886f57d5d468f73a08ab1a6574968f68833d82429db251",
    "token_format": "platform.<base64url(AuthClaims JSON)>",
    "required_claim_fields": [
      "claimContractVersion",
      "actorId",
      "actorKind",
      "runtimeBindingId",
      "credentialId",
      "orgId",
      "internal",
      "serviceScopes",
      "permittedOperations",
      "issuedAt",
      "expiresAt",
      "issuer",
      "audience",
      "correlationId"
    ],
    "actor_kinds": ["human", "persona", "service", "adapter", "program_executor"],
    "required_service_scope": "lskills",
    "required_audience": "lskills-api",
    "rejected": ["fake.* tokens", "snake_case aliases", "unknown fields", "actorKind agent"],
    "secrets": "none_in_fragment",
    "consumer_pin": "docs/contracts/frozen/platform-auth-claims-v1.0.0.CONSUMER-PIN.md"
  },
  "conformance": {
    "platform_claims_consumer_proven_in_linkskills": true,
    "live_openclaw_mutation": false,
    "awaiting_openclaw_repin_countersign": true
  }
}
