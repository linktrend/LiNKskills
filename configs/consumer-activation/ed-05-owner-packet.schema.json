{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/ed-05-owner-packet.schema.json",
  "title": "ED-05 disabled-by-default owner consumer packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "packetId",
    "consumer",
    "owner",
    "disabledByDefault",
    "activation",
    "providerContract",
    "platformAuth",
    "privateEndpoint",
    "pinsRef",
    "pins",
    "allowlist",
    "deny",
    "flows",
    "toolAuthority",
    "telemetryBounds",
    "rollback",
    "brainSkillsSeparation",
    "fragment",
    "handoff"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1" },
    "kind": { "type": "string", "const": "ed-05-owner-consumer-packet" },
    "packetId": {
      "type": "string",
      "enum": ["ed-05-cursor", "ed-05-codex", "ed-05-lisa-openclaw"]
    },
    "consumer": { "type": "string", "enum": ["cursor", "codex", "lisa-openclaw"] },
    "owner": { "type": "string", "minLength": 8, "maxLength": 240 },
    "disabledByDefault": { "type": "boolean", "const": true },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationOwner", "enabled", "liveApply", "consumerConfiguration"],
      "properties": {
        "activationOwner": { "type": "string", "const": "consumer" },
        "enabled": { "type": "boolean", "const": false },
        "liveApply": { "type": "boolean", "const": false },
        "consumerConfiguration": { "type": "boolean", "const": false }
      }
    },
    "providerContract": { "type": "string", "const": "skills.api.v0.2" },
    "platformAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimContract",
        "envelopeContract",
        "audience",
        "scope",
        "tokenMint",
        "brainCredentialReuse",
        "liveTokenProof",
        "callerMintedIdentityAllowed"
      ],
      "properties": {
        "claimContract": { "type": "string", "const": "platform.auth-claims/1.1.0" },
        "envelopeContract": { "type": "string", "const": "platform.auth-token-envelope/0.1.0" },
        "audience": { "type": "string", "const": "lskills-api" },
        "scope": { "type": "string", "const": "lskills" },
        "tokenMint": { "type": "string", "const": "client_credentials+private_key_jwt" },
        "brainCredentialReuse": { "type": "boolean", "const": false },
        "liveTokenProof": { "type": "boolean", "const": false },
        "callerMintedIdentityAllowed": { "type": "boolean", "const": false }
      }
    },
    "privateEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "liveUrl", "fixtureUrl", "tokenEndpointFixture", "httpsRequiredOutsideLocalTest"],
      "properties": {
        "kind": { "type": "string", "const": "skills-provider-v2" },
        "liveUrl": { "type": "null" },
        "fixtureUrl": {
          "type": "string",
          "const": "https://skills.test.linktrend.invalid/provider-v2"
        },
        "tokenEndpointFixture": {
          "type": "string",
          "const": "https://auth.test.linkplatform.invalid/oauth/token"
        },
        "httpsRequiredOutsideLocalTest": { "type": "boolean", "const": true }
      }
    },
    "pinsRef": {
      "type": "string",
      "const": "configs/consumer-activation/ed-05-initial-five-pins.json"
    },
    "pins": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "allowlist": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "git-safeguard@1.1.0",
          "persistent-qa@1.0.0",
          "repository-manager@1.0.0",
          "skill-template@1.2.0",
          "tool-architect@1.0.0"
        ]
      }
    },
    "deny": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nativeSubstitutes",
        "staleCache",
        "similarName",
        "latestPointer",
        "catalogExpansion",
        "unapprovedFallback",
        "legacyExecution"
      ],
      "properties": {
        "nativeSubstitutes": { "type": "boolean", "const": true },
        "staleCache": { "type": "boolean", "const": true },
        "similarName": { "type": "boolean", "const": true },
        "latestPointer": { "type": "boolean", "const": true },
        "catalogExpansion": { "type": "boolean", "const": true },
        "unapprovedFallback": { "type": "boolean", "const": true },
        "legacyExecution": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "enum": ["skills_run_*", "skills_tool_*"] }
        }
      }
    },
    "flows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privateEndpoint",
        "tokenMint",
        "resourceRetrieval",
        "verification",
        "localExecution",
        "useReport",
        "failure",
        "rollback"
      ],
      "properties": {
        "privateEndpoint": { "$ref": "#/$defs/flow" },
        "tokenMint": { "$ref": "#/$defs/flow" },
        "resourceRetrieval": { "$ref": "#/$defs/flow" },
        "verification": { "$ref": "#/$defs/flow" },
        "localExecution": { "$ref": "#/$defs/flow" },
        "useReport": { "$ref": "#/$defs/flow" },
        "failure": { "$ref": "#/$defs/flow" },
        "rollback": { "$ref": "#/$defs/flow" }
      }
    },
    "toolAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "providerDoesNotExecute", "consumerDeclaresTools"],
      "properties": {
        "execution": { "type": "string", "const": "consumer-local" },
        "providerDoesNotExecute": { "type": "boolean", "const": true },
        "consumerDeclaresTools": { "type": "boolean", "const": true }
      }
    },
    "telemetryBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "noSecrets",
        "noBrainTranscripts",
        "opaqueCorrelationOnly",
        "score10HasNoDiagnostics"
      ],
      "properties": {
        "schema": { "type": "string", "const": "use-report-v0.2" },
        "noSecrets": { "type": "boolean", "const": true },
        "noBrainTranscripts": { "type": "boolean", "const": true },
        "opaqueCorrelationOnly": { "type": "boolean", "const": true },
        "score10HasNoDiagnostics": { "type": "boolean", "const": true }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerRemovesOrDisablesPin",
        "providerStateUnchanged",
        "retainLocalBootstrap",
        "noLiveMutation"
      ],
      "properties": {
        "consumerRemovesOrDisablesPin": { "type": "boolean", "const": true },
        "providerStateUnchanged": { "type": "boolean", "const": true },
        "retainLocalBootstrap": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": ["agentsetup@1.3.0", "agentcomply@1.3.0"]
          }
        },
        "noLiveMutation": { "type": "boolean", "const": true }
      }
    },
    "brainSkillsSeparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "separateMcpServerName",
        "separateCredentials",
        "separateConfig",
        "skillsAudienceNeverBrain"
      ],
      "properties": {
        "separateMcpServerName": { "type": "string", "minLength": 8, "maxLength": 64 },
        "separateCredentials": { "type": "boolean", "const": true },
        "separateConfig": { "type": "boolean", "const": true },
        "skillsAudienceNeverBrain": { "type": "boolean", "const": true }
      }
    },
    "fragment": { "type": "string", "minLength": 16, "maxLength": 120 },
    "handoff": { "type": "string", "minLength": 16, "maxLength": 120 }
  },
  "$defs": {
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "live", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 64 },
        "live": { "type": "boolean", "const": false },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 4, "maxLength": 160 }
        }
      }
    }
  }
}
