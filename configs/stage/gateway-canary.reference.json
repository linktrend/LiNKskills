    "jwks_uri": "_PLATFORM_SUPPLIED_STAGE_PACI_JWKS_URI_",
    "audience": "lskills-api",
    "required_service_scopes": ["lskills"],
    "token_endpoint": "_PLATFORM_SUPPLIED_STAGE_PACI_TOKEN_ENDPOINT_",
