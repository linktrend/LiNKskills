    "client_kid": "_PLATFORM_SUPPLIED_STAGE_CLIENT_KID_",
    "scope": "_PLATFORM_SUPPLIED_STAGE_LEAST_PRIVILEGE_SCOPES_",
    "resource_audience": "lskills-api"
