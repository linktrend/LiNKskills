{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/release-record-v0.1.json",
  "title": "LiNKskills Release Record v0.1",
  "description": "Immutable published Skill Pack or tool release metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "artifact_kind",
    "artifact_id",
    "version",
    "bundle_hash",
    "channel",
    "lifecycle_state",
    "published_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "release_id": { "type": "string", "minLength": 1 },
    "artifact_kind": {
      "type": "string",
      "enum": ["skill_pack", "tool", "eval_suite"]
    },
    "artifact_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_commit": { "type": "string" },
    "channel": {
      "type": "string",
      "enum": ["development", "eval", "canary", "stable"]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "eval_pending", "usable", "deprecated", "retired"]
    },
    "published_at": { "type": "string", "format": "date-time" },
    "publisher": { "type": "string" },
    "storage_uri": { "type": "string" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_count": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "entry_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "execution_profiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "supersedes_release_id": { "type": "string" },
    "notes": { "type": "string" }
  }
}
