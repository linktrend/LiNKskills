{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/provider-taxonomy-v0.1.json",
  "title": "LiNKskills Provider Taxonomy v0.1",
  "description": "The single curated family-first taxonomy owned by LiNKskills.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "taxonomy_version", "owner", "trust_boundary", "families"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "taxonomy_id": { "$ref": "#/$defs/id" },
    "taxonomy_version": { "$ref": "#/$defs/semver" },
    "owner": { "type": "string", "const": "linkskills" },
    "trust_boundary": { "type": "string", "const": "linkskills-taxonomy" },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 280 },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "display_name", "description", "subcategories"],
      "properties": {
        "family_id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "$ref": "#/$defs/description" },
        "subcategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/subcategory" }
        }
      }
    },
    "subcategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subcategory_id", "display_name", "description"],
      "properties": {
        "subcategory_id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "$ref": "#/$defs/description" },
        "collections": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/collection" },
          "default": []
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_id", "display_name", "description"],
      "properties": {
        "collection_id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "$ref": "#/$defs/description" }
      }
    }
  }
}
