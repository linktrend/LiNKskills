{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/exact-resource-descriptor-v0.1.json",
  "title": "LiNKskills Exact Resource Descriptor v0.1",
  "description": "Addressable immutable bytes selected from one exact release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resource_id", "release_id", "skill_id", "skill_version", "resource_kind", "resource_uri", "media_type", "byte_size", "content_digest", "immutable", "disclosure_level", "provenance", "licence", "trust_boundary"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "resource_id": { "$ref": "#/$defs/id" },
    "release_id": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "skill_id": { "$ref": "#/$defs/id" },
    "skill_version": { "$ref": "#/$defs/semver" },
    "resource_kind": { "type": "string", "enum": ["entrypoint", "fragment", "instruction", "schema", "example", "asset", "manifest"] },
    "resource_uri": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^skills://release/" },
    "media_type": { "type": "string", "enum": ["text/markdown", "text/plain", "application/json", "application/octet-stream"] },
    "byte_size": { "type": "integer", "minimum": 0 },
    "content_digest": { "$ref": "#/$defs/digest" },
    "immutable": { "type": "boolean", "const": true },
    "disclosure_level": { "type": "integer", "minimum": 0, "maximum": 6 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "publisher", "repository", "source_ref", "source_commit", "source_path", "retrieved_at"],
      "properties": {
        "source_kind": { "type": "string", "enum": ["native", "vendor", "adapted"] },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 160 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 160 },
        "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$" },
        "source_path": { "$ref": "#/$defs/relative_path" },
        "retrieved_at": { "type": "string", "format": "date-time", "maxLength": 40 },
        "upstream_release_id": { "type": "string", "minLength": 3 }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["licence_id", "attribution_required", "review_status"],
      "properties": {
        "licence_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "attribution_required": { "type": "boolean" },
        "notice_ref": { "type": "string", "pattern": "^opaque:[A-Za-z0-9][A-Za-z0-9._:/-]{1,158}$" },
        "review_status": { "type": "string", "enum": ["not_required", "reviewed_compatible", "reviewed_incompatible"] }
      }
    },
    "trust_boundary": { "type": "string", "const": "linkskills-resource" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relative_path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._@+, -]+(?:/[A-Za-z0-9._@+, -]+)*$" }
  }
}
