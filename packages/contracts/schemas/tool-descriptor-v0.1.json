{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/tool-descriptor-v0.1.json",
  "title": "LiNKskills Tool Descriptor v0.1",
  "description": "Canonical packaged-tool descriptor for registry and exact-hash resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_id",
    "version",
    "description",
    "entrypoint",
    "platforms",
    "side_effect_class",
    "lifecycle_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "tool_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "source_path": { "type": "string" },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "command"],
      "properties": {
        "transport": {
          "type": "string",
          "enum": ["cli", "python", "http", "mcp", "other"]
        },
        "command": { "type": "string", "minLength": 1 },
        "working_directory": { "type": "string" }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["macos", "linux", "windows", "any"]
      },
      "minItems": 1
    },
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "integer", "number", "boolean"] }
        }
      },
      "default": []
    },
    "side_effect_class": {
      "type": "string",
      "enum": ["read_only", "local_write", "network", "external_side_effect", "destructive"]
    },
    "reversibility": {
      "type": "string",
      "enum": ["none", "compensating", "idempotent", "unknown"]
    },
    "required_secret_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Secret names only — never values.",
      "default": []
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "network_boundaries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "filesystem_boundaries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "timeout_seconds": { "type": "number", "minimum": 0 },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "backoff": {
          "type": "string",
          "enum": ["none", "fixed", "exponential"]
        },
        "idempotent": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smoke_tests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "test_path": { "type": "string" }
      }
    },
    "owning_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "reverse_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "eval_pending", "usable", "deprecated", "retired"]
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replacement_tool_id": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
