{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/eval-suite-v0.1.json",
  "title": "LiNKskills Eval Suite v0.1",
  "description": "Certification-ready eval suite definition. Prompt-only scoring is not sufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "skill_id",
    "suite_version",
    "skill_version_range",
    "pass_threshold",
    "rubric",
    "cases",
    "evidence_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "suite_id": { "type": "string", "minLength": 1 },
    "skill_id": { "type": "string", "minLength": 1 },
    "suite_version": { "type": "string", "minLength": 1 },
    "suite_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "skill_version_range": { "type": "string", "minLength": 1 },
    "required_runtime_profiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "required_execution_profiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "path"],
        "properties": {
          "fixture_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "default": []
    },
    "pass_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "weight"],
        "properties": {
          "dimension": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "hard_fail_below": { "type": "number", "minimum": 0, "maximum": 1 },
          "anchors": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "examples": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "hard_failure_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "per_dimension_minimums": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "toolchain_lock": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "version"],
        "properties": {
          "tool_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "bundle_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "default": []
    },
    "permitted_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["for_tool_id", "alternative_tool_id"],
        "properties": {
          "for_tool_id": { "type": "string", "minLength": 1 },
          "alternative_tool_id": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_reasoning_tier": {
          "type": "string",
          "enum": ["low", "balanced", "high", "frontier"]
        },
        "independence_required": { "type": "boolean", "default": true },
        "model_family_exclusions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0 },
        "max_duration_seconds": { "type": "number", "minimum": 0 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retain", "redact"],
      "properties": {
        "retain": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "redact": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "regression_baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_suite_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "comparison_rule": { "type": "string" }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires_clean_workspace": { "type": "boolean", "default": true },
        "cleanup_required": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_type", "input", "expected"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "case_type": {
          "type": "string",
          "enum": [
            "golden",
            "edge",
            "negative",
            "adversarial",
            "regression",
            "routing",
            "tool_failure",
            "compatibility",
            "efficiency",
            "side_effect_safety"
          ]
        },
        "input": { "type": "string", "minLength": 1 },
        "contextual_inputs": {
          "type": "object",
          "additionalProperties": true
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criteria"],
          "properties": {
            "criteria": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1
            },
            "output_contract": { "type": "string" },
            "artifact_contract": { "type": "string" }
          }
        },
        "deterministic_assertions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "must_contain": {
              "type": "array",
              "items": { "type": "string" }
            },
            "must_not_contain": {
              "type": "array",
              "items": { "type": "string" }
            },
            "json_path_equals": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "hard_fail_on": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}
