{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/use-report-v0.2.json",
  "title": "LiNKskills Use Report v0.2",
  "description": "Bounded completed-use and separate non-use telemetry record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_kind", "report_id", "occurred_at", "skill_id", "skill_release_ref", "consumer_class", "actor_ref", "runtime_profile_ref", "outcome", "opaque_refs", "idempotency_source", "server_idempotency_key"],
  "x-forbidden-property-names": ["secret", "secrets", "password", "token", "access_token", "refresh_token", "authorization", "private_key", "credential", "prompt", "transcript", "conversation", "raw", "raw_input", "raw_output", "narrative", "notes", "fragment", "fragments", "customer", "consumer_data", "case", "lead", "trading_order", "portfolio", "brokerage"],
  "oneOf": [
    {
      "type": "object",
      "required": ["report_kind", "score"],
      "properties": {
        "report_kind": { "const": "completed_use" },
        "score": { "type": "integer", "minimum": 0, "maximum": 9 },
        "issue": { "$ref": "#/$defs/typedIssue" }
      },
      "additionalProperties": true,
      "required": ["issue"]
    },
    {
      "type": "object",
      "required": ["report_kind", "score"],
      "properties": { "report_kind": { "const": "completed_use" }, "score": { "type": "integer", "const": 10 } },
      "not": { "required": ["issue"] },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["report_kind", "non_use_outcome"],
      "properties": {
        "report_kind": { "const": "non_use" },
        "non_use_outcome": { "type": "string", "enum": ["not_requested", "not_selected", "incompatible", "unavailable", "rejected_by_human_gate", "expired", "revoked", "auth_denied", "cancelled", "superseded"] }
      },
      "not": { "anyOf": [{ "required": ["score"] }, { "required": ["issue"] }] },
      "additionalProperties": true
    }
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.2" },
    "report_kind": { "type": "string", "enum": ["completed_use", "non_use"] },
    "report_id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^opaque:[A-Za-z0-9][A-Za-z0-9._:/-]{1,94}$" },
    "occurred_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "skill_id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "skill_release_ref": { "$ref": "#/$defs/opaqueRef" },
    "consumer_class": { "type": "string", "enum": ["codex", "cursor", "openclaw", "linkdeveloper", "linksites", "other"] },
    "actor_ref": { "$ref": "#/$defs/opaqueRef" },
    "actor_class": { "type": "string", "enum": ["human_operator", "service_actor", "agent_actor", "unknown"] },
    "runtime_profile_ref": { "$ref": "#/$defs/opaqueRef" },
    "outcome": { "type": "string", "enum": ["use_succeeded", "use_failed", "use_partial", "not_used"] },
    "opaque_refs": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "$ref": "#/$defs/opaqueRef" } },
    "idempotency_source": { "type": "string", "const": "server" },
    "server_idempotency_key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "client_idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "score": { "type": "integer", "minimum": 0, "maximum": 10 },
    "issue": { "$ref": "#/$defs/typedIssue" },
    "non_use_outcome": { "type": "string", "enum": ["not_requested", "not_selected", "incompatible", "unavailable", "rejected_by_human_gate", "expired", "revoked", "auth_denied", "cancelled", "superseded"] }
  },
  "$defs": {
    "opaqueRef": { "type": "string", "minLength": 3, "maxLength": 160, "pattern": "^opaque:[A-Za-z0-9][A-Za-z0-9._:/-]{1,158}$" },
    "typedIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "issue_ref"],
      "properties": {
        "type": { "type": "string", "enum": ["incorrect", "incomplete", "ambiguous", "unsafe", "incompatible", "unavailable", "latency", "other"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "issue_ref": { "$ref": "#/$defs/opaqueRef" }
      }
    }
  }
}
