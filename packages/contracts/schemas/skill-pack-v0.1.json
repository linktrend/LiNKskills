{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linktrend.dev/schemas/linkskills/skill-pack-v0.1.json",
  "title": "LiNKskills Skill Pack v0.1",
  "description": "Canonical Skill Pack metadata and execution contract for publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "display_name",
    "version",
    "description",
    "capability_category",
    "lifecycle_state",
    "format_profile",
    "routing",
    "execution",
    "dependencies",
    "eval",
    "telemetry"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "display_name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic version of this Skill Pack."
    },
    "description": { "type": "string", "minLength": 1 },
    "capability_category": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "source": { "type": "string" },
        "license": { "type": "string" },
        "imported_from": { "type": "string" }
      }
    },
    "source_commit": { "type": "string" },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "release_channel": {
      "type": "string",
      "enum": ["development", "eval", "canary", "stable"]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "eval_pending", "usable", "deprecated", "retired"]
    },
    "format_profile": {
      "type": "string",
      "enum": ["simple", "heavy"]
    },
    "compatible_runtime_profiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "min_capability_tier": {
      "type": "string",
      "enum": ["low", "balanced", "high", "frontier"]
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when_to_use", "when_not_to_use", "tags"],
      "properties": {
        "when_to_use": { "type": "string", "minLength": 1 },
        "when_not_to_use": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "exclusion_rules": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "ambiguity_rules": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "related_skills": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "alternative_skills": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "superseded_by": { "type": "string" },
        "prerequisite_skills": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "recommended_disclosure_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "default": 2
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_inputs",
        "expected_outputs",
        "forbidden_actions",
        "verification_steps",
        "completion_criteria"
      ],
      "properties": {
        "required_inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ioField" }
        },
        "optional_inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ioField" },
          "default": []
        },
        "input_schema": { "type": "object" },
        "expected_outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ioField" },
          "minItems": 1
        },
        "procedure_summary": { "type": "string" },
        "forbidden_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "failure_handling": { "type": "string" },
        "verification_steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "completion_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "known_limitations": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Typed dependency buckets (dependency-types-v0.1).",
      "required": [
        "schema_version",
        "skill_dependencies",
        "packaged_tools",
        "host_capabilities",
        "external_services",
        "library_assets",
        "runtime_requirements",
        "optional_dependencies"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "0.1" },
        "skill_dependencies": { "type": "array" },
        "packaged_tools": { "type": "array" },
        "host_capabilities": { "type": "array" },
        "external_services": { "type": "array" },
        "library_assets": { "type": "array" },
        "runtime_requirements": { "type": "array" },
        "optional_dependencies": { "type": "array" },
        "certified_alternatives": { "type": "array" }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_path", "suite_schema_version"],
      "properties": {
        "suite_path": { "type": "string", "minLength": 1 },
        "suite_schema_version": { "type": "string", "const": "0.1" },
        "suite_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "required_certification_profiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "verification_refs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "redaction_rules", "retention_policy"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["public_internal", "restricted", "sensitive"]
        },
        "redaction_rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "retention_policy": { "type": "string", "minLength": 1 },
        "cost_budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tokens": { "type": "integer", "minimum": 0 },
            "max_tool_calls": { "type": "integer", "minimum": 0 },
            "max_duration_seconds": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragment_id", "disclosure_level", "path"],
        "properties": {
          "fragment_id": { "type": "string", "minLength": 1 },
          "disclosure_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "path": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    }
  },
  "$defs": {
    "ioField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string" },
        "schema": { "type": "object" }
      }
    }
  }
}
