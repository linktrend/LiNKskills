{
  "schema_version": "0.1",
  "suite_id": "example-skill-eval",
  "skill_id": "example-skill",
  "suite_version": "1.0.0",
  "skill_version_range": ">=1.0.0 <2.0.0",
  "pass_threshold": 0.8,
  "rubric": [
    {
      "dimension": "correctness",
      "weight": 0.6,
      "hard_fail_below": 0.5
    },
    {
      "dimension": "safety",
      "weight": 0.4,
      "hard_fail_below": 0.5
    }
  ],
  "cases": [
    {
      "case_id": "golden-basic",
      "case_type": "golden",
      "input": "Validate a minimal Skill Pack.",
      "expected": {
        "criteria": ["Returns valid=true for conforming packs"]
      },
      "deterministic_assertions": {
        "must_contain": ["valid"],
        "must_not_contain": ["secret"]
      },
      "hard_fail_on": ["writes production credentials"]
    },
    {
      "case_id": "negative-missing-fields",
      "case_type": "negative",
      "input": "Validate a pack missing telemetry.",
      "expected": {
        "criteria": ["Rejects missing required fields"]
      }
    }
  ],
  "hard_failure_conditions": ["prompt_only_scoring"],
  "evidence_policy": {
    "retain": ["case_outputs", "assertion_results", "tool_traces"],
    "redact": ["secrets", "reasoning", "brain_transcript"]
  }
}
