{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_state_ref",
            "founder_confirmed_operating_model",
            "domain_modules_requested",
            "seed_document_refs",
            "known_company_facts",
            "requested_depth",
            "current_native_capabilities"
          ],
          "properties": {
            "profile_state_ref": {
              "type": "string"
            },
            "founder_confirmed_operating_model": {
              "type": "string"
            },
            "domain_modules_requested": {
              "type": "string"
            },
            "seed_document_refs": {
              "type": "string"
            },
            "known_company_facts": {
              "type": "string"
            },
            "requested_depth": {
              "type": "string"
            },
            "current_native_capabilities": {
              "type": "string"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_draft",
            "source_fact_register",
            "conflicts_and_unknowns",
            "domain_module_selection",
            "open_founder_questions",
            "capability_gaps"
          ],
          "properties": {
            "profile_draft": {
              "type": "string"
            },
            "source_fact_register": {
              "type": "string"
            },
            "conflicts_and_unknowns": {
              "type": "string"
            },
            "domain_module_selection": {
              "type": "string"
            },
            "open_founder_questions": {
              "type": "string"
            },
            "capability_gaps": {
              "type": "string"
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    }
  }
}
