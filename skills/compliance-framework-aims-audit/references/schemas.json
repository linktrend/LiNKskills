{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_request",
            "source_documents",
            "company_context",
            "applicability_context",
            "review_owner",
            "aims_scope",
            "audit_cycle",
            "control_evidence",
            "auditor_independence"
          ],
          "properties": {
            "task_request": {
              "type": "string",
              "minLength": 1
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "company_context": {
              "type": "string"
            },
            "applicability_context": {
              "type": "string"
            },
            "review_owner": {
              "type": "string"
            },
            "aims_scope": {
              "type": "string",
              "description": "AIMS boundary, covered AI systems and organizational units."
            },
            "audit_cycle": {
              "type": "string",
              "description": "Requested audit stage/period and prior findings."
            },
            "control_evidence": {
              "type": "string",
              "description": "Clause/control evidence, risk register, objectives and management-review materials."
            },
            "auditor_independence": {
              "type": "string",
              "description": "Evidence about auditor roles and independence."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_and_criteria",
            "clause_evidence_matrix",
            "ai_risk_register_review",
            "audit_plan_and_independence",
            "cross_framework_reuse",
            "gaps_and_owner_questions"
          ],
          "properties": {
            "scope_and_criteria": {
              "type": "string",
              "description": "Task-specific draft field: scope and criteria"
            },
            "clause_evidence_matrix": {
              "type": "array",
              "description": "Task-specific draft field: clause evidence matrix",
              "items": {
                "type": "string"
              }
            },
            "ai_risk_register_review": {
              "type": "string",
              "description": "Task-specific draft field: ai risk register review"
            },
            "audit_plan_and_independence": {
              "type": "string",
              "description": "Task-specific draft field: audit plan and independence"
            },
            "cross_framework_reuse": {
              "type": "string",
              "description": "Task-specific draft field: cross framework reuse"
            },
            "gaps_and_owner_questions": {
              "type": "array",
              "description": "Task-specific draft field: gaps and owner questions",
              "items": {
                "type": "string"
              }
            },
            "partial_work": {
              "type": "array",
              "description": "Separable work completed despite a material input gap; empty only when none was possible.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section",
                  "content",
                  "evidence_refs"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "missing_inputs": {
              "type": "array",
              "description": "Exact absent or inaccessible input and why it blocks the dependent conclusion.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requested_owner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "unknown_facts": {
              "type": "array",
              "description": "Facts that remain unknown or conflicting; never fill them with invented values.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "why_unknown",
                  "evidence_refs"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why_unknown": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "title": "sara-completed-draft-content",
          "if": {
            "properties": {
              "status": {
                "const": "completed_draft"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "work_product": {
                "required": [
                  "scope_and_criteria",
                  "clause_evidence_matrix",
                  "ai_risk_register_review",
                  "audit_plan_and_independence",
                  "cross_framework_reuse"
                ],
                "properties": {
                  "scope_and_criteria": {
                    "minLength": 1
                  },
                  "clause_evidence_matrix": {
                    "minItems": 1
                  },
                  "ai_risk_register_review": {
                    "minLength": 1
                  },
                  "audit_plan_and_independence": {
                    "minLength": 1
                  },
                  "cross_framework_reuse": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "title": "sara-needs-context-record",
          "if": {
            "properties": {
              "status": {
                "const": "needs_context"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "partial_work",
                  "missing_inputs",
                  "unknown_facts"
                ],
                "properties": {
                  "missing_inputs": {
                    "minItems": 1
                  },
                  "unknown_facts": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "checkpoint_ref",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "review",
            "delivered"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "waiting_for_input",
            "completed_draft",
            "blocked"
          ]
        },
        "checkpoint_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Consumer-owner checkpoint reference; no local runtime sidecar."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
