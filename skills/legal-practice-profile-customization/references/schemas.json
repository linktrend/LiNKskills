{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_profile_ref",
            "requested_change",
            "domain",
            "supporting_source_refs",
            "change_owner",
            "approval_status",
            "current_native_capabilities"
          ],
          "properties": {
            "current_profile_ref": {
              "type": "string"
            },
            "requested_change": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "supporting_source_refs": {
              "type": "string"
            },
            "change_owner": {
              "type": "string"
            },
            "approval_status": {
              "type": "string"
            },
            "current_native_capabilities": {
              "type": "string"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change_summary",
            "before_after_delta",
            "source_and_rationale",
            "impact_and_dependent_sections",
            "required_owner_confirmation",
            "interface_gap"
          ],
          "properties": {
            "change_summary": {
              "type": "string"
            },
            "before_after_delta": {
              "type": "string"
            },
            "source_and_rationale": {
              "type": "string"
            },
            "impact_and_dependent_sections": {
              "type": "string"
            },
            "required_owner_confirmation": {
              "type": "string"
            },
            "interface_gap": {
              "type": "string"
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    }
  }
}
