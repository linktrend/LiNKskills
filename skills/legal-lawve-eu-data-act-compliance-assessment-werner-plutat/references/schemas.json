{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {},
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product_or_service",
            "actors_and_roles",
            "data_and_access",
            "request_or_contract",
            "authority_snapshot",
            "scope_and_as_of"
          ],
          "properties": {
            "product_or_service": {
              "type": "string",
              "description": "Connected product, related service, data-processing service or other subject."
            },
            "actors_and_roles": {
              "type": "string",
              "description": "Manufacturer, data holder, user, recipient, provider or public body roles."
            },
            "data_and_access": {
              "type": "string",
              "description": "Data generated, readily available, access format, trade secrets and personal-data context."
            },
            "request_or_contract": {
              "type": "string",
              "description": "B2B/B2C/B2G request, contract term, switching or interoperability issue."
            },
            "authority_snapshot": {
              "type": "string",
              "description": "Current official Regulation (EU) 2023/2854, amendments, guidance, national measures and date."
            },
            "scope_and_as_of": {
              "type": "string",
              "description": "Applicable scope and date; state unknown rather than infer."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_type",
        "task_specific_deliverable",
        "evidence_trace",
        "uncertainties",
        "external_effects",
        "mutations"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed_draft",
            "needs_context",
            "not_applicable"
          ]
        },
        "artifact_type": {
          "const": "legal-lawve-eu-data-act-compliance-assessment-werner-plutat"
        },
        "task_specific_deliverable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_and_role_analysis",
            "data_flow_and_request_map",
            "article_by_article_obligation_matrix",
            "contract_or_design_gaps",
            "effective_date_questions",
            "owner_actions"
          ],
          "properties": {
            "scope_and_role_analysis": {
              "type": "string"
            },
            "data_flow_and_request_map": {
              "type": "string"
            },
            "article_by_article_obligation_matrix": {
              "type": "string"
            },
            "contract_or_design_gaps": {
              "type": "string"
            },
            "effective_date_questions": {
              "type": "string"
            },
            "owner_actions": {
              "type": "string"
            }
          }
        },
        "evidence_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "source_ref",
              "pinpoint",
              "basis"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "pinpoint": {
                "type": "string"
              },
              "basis": {
                "enum": [
                  "verified_fact",
                  "requestor_assertion",
                  "inference",
                  "proposal",
                  "unknown"
                ]
              }
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "source_refs",
        "established_facts",
        "open_inputs",
        "next_action",
        "last_updated"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "verification",
            "complete"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "established_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
