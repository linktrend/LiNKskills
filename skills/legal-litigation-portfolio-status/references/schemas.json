{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "portfolio_record_ref",
            "as_of_date",
            "risk_and_staleness_definitions",
            "date_authority_refs",
            "scope_filter"
          ],
          "properties": {
            "portfolio_record_ref": {
              "type": "string",
              "description": "Authorized complete or bounded structured matter list."
            },
            "as_of_date": {
              "type": "string",
              "description": "Explicit report cutoff."
            },
            "risk_and_staleness_definitions": {
              "type": "string",
              "description": "Owner-approved thresholds and definitions, if supplied."
            },
            "date_authority_refs": {
              "type": "string",
              "description": "Orders/records and counsel-verified date calculations where needed."
            },
            "scope_filter": {
              "type": "string",
              "description": "Active/all/risk/stale selections and exclusions."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "portfolio_rollup",
            "upcoming_date_table",
            "anomaly_register",
            "scope_and_method"
          ],
          "properties": {
            "portfolio_rollup": {
              "type": "string",
              "description": "Counts and distributions with denominator/coverage."
            },
            "upcoming_date_table": {
              "type": "string",
              "description": "Quoted-source dates with verification state."
            },
            "anomaly_register": {
              "type": "string",
              "description": "Missing, stale, inconsistent, overdue-as-recorded or unsupported fields."
            },
            "scope_and_method": {
              "type": "string",
              "description": "As-of date, records included/excluded, threshold source and caveats."
            },
            "partial_work": {
              "type": "array",
              "description": "Separable work completed despite a material input gap; empty only when none was possible.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section",
                  "content",
                  "evidence_refs"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "missing_inputs": {
              "type": "array",
              "description": "Exact absent or inaccessible input and why it blocks the dependent conclusion.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requested_owner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "unknown_facts": {
              "type": "array",
              "description": "Facts that remain unknown or conflicting; never fill them with invented values.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "why_unknown",
                  "evidence_refs"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why_unknown": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "title": "sara-completed-draft-content",
          "if": {
            "properties": {
              "status": {
                "const": "completed_draft"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "work_product": {
                "required": [
                  "portfolio_rollup",
                  "upcoming_date_table",
                  "anomaly_register",
                  "scope_and_method"
                ],
                "properties": {
                  "portfolio_rollup": {
                    "minLength": 1
                  },
                  "upcoming_date_table": {
                    "minLength": 1
                  },
                  "anomaly_register": {
                    "minLength": 1
                  },
                  "scope_and_method": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "title": "sara-needs-context-record",
          "if": {
            "properties": {
              "status": {
                "const": "needs_context"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "partial_work",
                  "missing_inputs",
                  "unknown_facts"
                ],
                "properties": {
                  "missing_inputs": {
                    "minItems": 1
                  },
                  "unknown_facts": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at",
        "source_refs"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
