{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:linkskills:trading-earnings-analysis:0.1.1",
  "title": "Earnings analysis",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "fiscal_period",
        "event_datetime",
        "timezone",
        "analysis_mode",
        "consensus_vintage",
        "metrics",
        "reaction_window"
      ],
      "properties": {
        "issuer": {
          "type": "string"
        },
        "fiscal_period": {
          "type": "string"
        },
        "event_datetime": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Required event time for preview/results/combined. Null is permitted only for estimate_change when event timing is unresolved and event_datetime_unknown_reason is supplied."
        },
        "timezone": {
          "type": "string"
        },
        "analysis_mode": {
          "enum": [
            "preview",
            "results",
            "estimate_change",
            "combined"
          ]
        },
        "consensus_vintage": {
          "type": [
            "object",
            "null"
          ]
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reaction_window": {
          "type": [
            "object",
            "null"
          ],
          "description": "Null or empty when reaction analysis is not requested or lacks aligned market evidence; estimate-change analysis does not require a market-reaction basis."
        },
        "portfolio_context": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional user-supplied portfolio context for advisory sensitivity only; never authorizes changes or execution.",
          "required": [
            "as_of",
            "base_currency",
            "holdings",
            "risk_constraints"
          ],
          "properties": {
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "base_currency": {
              "type": "string"
            },
            "nav": {
              "type": [
                "number",
                "null"
              ],
              "description": "Amount in base_currency; null when not supplied."
            },
            "holdings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instrument",
                  "quantity",
                  "currency",
                  "as_of"
                ],
                "properties": {
                  "instrument": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "market_value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "multiplier": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "source_pointer": {
                    "type": "string"
                  }
                }
              }
            },
            "risk_constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mandate_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_observations": {
          "type": "array",
          "description": "Optional actual/estimate/guidance observations for the requested earnings branch; all comparisons require matching period, definition, unit, source vintage and timestamps.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "value",
              "unit",
              "status",
              "fiscal_period",
              "source_pointer",
              "source_published_at",
              "source_vintage"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "basis": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "actual",
                  "estimate",
                  "guidance",
                  "prior_estimate",
                  "new_estimate",
                  "previous_guidance",
                  "new_guidance"
                ]
              },
              "fiscal_period": {
                "type": "string"
              },
              "source_pointer": {
                "type": "string"
              },
              "source_published_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_vintage": {
                "type": "string"
              }
            }
          }
        },
        "event_datetime_unknown_reason": {
          "type": "string",
          "minLength": 1,
          "description": "Required when estimate_change has an unresolved event_datetime; describe why the date is unknown. Does not authorize event-window or causal analysis."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "analysis_mode": {
                "const": "estimate_change"
              }
            },
            "required": [
              "analysis_mode"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "event_datetime": {
                  "type": "null"
                }
              },
              "required": [
                "event_datetime"
              ]
            },
            "then": {
              "required": [
                "event_datetime_unknown_reason"
              ]
            },
            "else": {
              "properties": {
                "event_datetime": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "else": {
            "properties": {
              "event_datetime": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_status",
        "issuer",
        "fiscal_period",
        "actual_vs_expectation",
        "guidance_changes",
        "reaction",
        "causal_limits",
        "missing_inputs"
      ],
      "properties": {
        "completion_status": {
          "enum": [
            "complete",
            "partial",
            "insufficient_input"
          ]
        },
        "issuer": {
          "type": "string"
        },
        "fiscal_period": {
          "type": "string"
        },
        "actual_vs_expectation": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "guidance_changes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reaction": {
          "type": [
            "object",
            "null"
          ]
        },
        "causal_limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimate_revisions": {
          "type": "array",
          "description": "Optional metric-level estimate revisions. Each side retains its own value, unit, period, dated source pointer and vintage. Compare only when the two observations align in period, definition and units.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "old_observation",
              "new_observation",
              "comparison_status",
              "basis_note"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "old_observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit",
                  "fiscal_period",
                  "source_pointer",
                  "source_published_at",
                  "source_vintage"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string"
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fiscal_period": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_pointer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_published_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "source_vintage": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "new_observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit",
                  "fiscal_period",
                  "source_pointer",
                  "source_published_at",
                  "source_vintage"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string"
                  },
                  "currency": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "fiscal_period": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_pointer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_published_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "source_vintage": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "comparison_status": {
                "type": "string",
                "enum": [
                  "comparable",
                  "not_comparable",
                  "partial_named_missing_items"
                ]
              },
              "change": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "change_unit": {
                "type": "string"
              },
              "basis_note": {
                "type": "string"
              }
            },
            "description": "Two independent estimate snapshots with their own dated provenance. Include comparison_status and basis_note when emitting this row; do not compute change across unlike units, definitions, or fiscal periods."
          }
        },
        "advisory_portfolio_proposal": {
          "type": "object",
          "additionalProperties": false,
          "description": "Advisory proposal only. Does not authorize orders, signing, live activation or policy changes.",
          "required": [
            "status",
            "proposals",
            "missing_basis"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "advisory_proposal",
                "partial",
                "unavailable_missing_basis",
                "not_requested"
              ]
            },
            "proposals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instrument_or_scope",
                  "proposal",
                  "basis",
                  "invalidation"
                ],
                "properties": {
                  "instrument_or_scope": {
                    "type": "string"
                  },
                  "proposal": {
                    "type": "string"
                  },
                  "target_or_risk_level": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "basis": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "invalidation": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "missing_basis": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "branch_status": {
          "type": "array",
          "description": "Independent status for estimate-change, surprise, guidance, reaction and thesis/valuation branches. Missing evidence in one branch does not suppress other supported findings.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch",
              "status",
              "basis"
            ],
            "properties": {
              "branch": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete_from_supplied_evidence",
                  "partial_named_missing_items",
                  "unavailable_missing_basis",
                  "not_requested"
                ]
              },
              "basis": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
