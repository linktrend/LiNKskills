        "analysis_mode": "estimate_change",
        "consensus_vintage": null,
        "metrics": [
          "revenue"
        ],
        "reaction_window": null,
        "source_observations": [
          {
            "metric": "revenue estimate",
            "value": 110,
            "unit": "USD millions",
            "status": "estimate",
            "fiscal_period": "FY2026 Q3",
            "source_pointer": "user-supplied://fixture/A",
            "source_published_at": "2026-09-10T10:00:00Z",
            "source_vintage": "A"
          },
          {
            "metric": "revenue estimate",
            "value": 114,
            "unit": "USD millions",
            "status": "estimate",
            "fiscal_period": "FY2026 Q3",
            "source_pointer": "user-supplied://fixture/B",
            "source_published_at": "2026-09-25T10:00:00Z",
            "source_vintage": "B"
          }
        ]
      },
      "expected": {
        "criteria": [
          "input accepted by the successor input schema; output may contain a revision only if the two source records are comparable; each output side retains its own published time, pointer and vintage; event reaction remains unavailable.",
          "Do not infer a release/event date from estimate snapshot dates.",
          "Do not emit beat/miss without an actual and comparable pre-release consensus.",
          "Do not infer reaction or causation from the revision snapshots."
        ]
      }
    },
    {
      "case_id": "trading-earnings-analysis-estimate-change-missing-date-reason-invalid",
      "case_type": "edge",
      "input": "Reject the invalid event-time contract; do not invent a date or approve the missing provenance.",
