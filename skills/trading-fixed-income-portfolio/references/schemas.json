{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:linkskills:trading-fixed-income-portfolio:0.1.0",
  "title": "Fixed income portfolio review",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_as_of",
        "currency",
        "holdings",
        "data_source"
      ],
      "properties": {
        "portfolio_as_of": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string"
        },
        "data_source": {
          "type": "string"
        },
        "holdings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "security_id",
              "market_value",
              "market_value_unit",
              "modified_duration",
              "duration_unit",
              "dv01",
              "dv01_unit"
            ],
            "properties": {
              "security_id": {
                "type": "string"
              },
              "market_value": {
                "type": "number",
                "minimum": 0
              },
              "market_value_unit": {
                "type": "string"
              },
              "modified_duration": {
                "type": "number"
              },
              "duration_unit": {
                "const": "years"
              },
              "dv01": {
                "type": "number"
              },
              "dv01_unit": {
                "type": "string"
              },
              "rating": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "maturity_date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "scenario_pnl": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "benchmark": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_status",
        "portfolio_as_of",
        "currency",
        "metrics",
        "concentration",
        "limitations",
        "missing_inputs"
      ],
      "properties": {
        "completion_status": {
          "enum": [
            "complete",
            "partial",
            "insufficient_input"
          ]
        },
        "portfolio_as_of": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "unit"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "concentration": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
