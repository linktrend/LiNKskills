{
  "definitions": {
    "input": {
      "type": "object",
      "required": ["task_id", "target", "requested_action", "content_trust", "brain_rules"],
      "additionalProperties": false,
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "requested_action": { "type": "string", "enum": ["public_read", "authenticated_read", "prepare_form", "reversible_change", "communication", "commitment", "purchase_legal", "upload_download", "prohibited"] },
        "content_trust": { "type": "string", "enum": ["static_or_api", "public_page", "untrusted_page", "unknown"] },
        "brain_rules": { "type": "array", "items": { "type": "string" } },
        "approval": { "type": "string", "enum": ["none", "consumer_approved", "principal_approved", "unknown"] },
        "credentials_present": { "type": "boolean" },
        "private_network": { "type": "boolean" },
        "bot_protection": { "type": "string", "enum": ["none", "uncertain", "blocked", "unknown"] },
        "download_requested": { "type": "boolean" },
        "standing_rule": { "type": "string", "enum": ["none", "propose", "activate"] },
        "destination": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "required": ["status", "action_class", "decision", "approval", "effects", "controls", "rollback"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["COMPLETED", "PENDING_APPROVAL", "DENIED"] },
        "action_class": { "type": "string", "enum": ["public_read", "authenticated_read", "prepare_form", "reversible_change", "communication", "commitment", "purchase_legal", "upload_download", "prohibited"] },
        "decision": { "type": "string", "minLength": 1 },
        "approval": { "type": "object", "required": ["status"], "additionalProperties": false, "properties": { "status": { "type": "string", "enum": ["NOT_REQUIRED", "PENDING_APPROVAL", "DENIED"] }, "owner": { "type": "string" }, "reason": { "type": "string" } } },
        "effects": { "type": "object", "required": ["external_calls", "mutations", "messages_sent", "downloads_opened"], "additionalProperties": false, "properties": { "external_calls": { "type": "array", "maxItems": 0 }, "mutations": { "type": "array", "maxItems": 0 }, "messages_sent": { "type": "array", "maxItems": 0 }, "downloads_opened": { "type": "array", "maxItems": 0 } } },
        "controls": { "type": "array", "items": { "type": "string" } },
        "rollback": { "type": "string", "const": "ABSENT@39a1a1a0238f036fbf5a696986b1b5215eb366be/tree:ce1cbf16af9d3363efd2f2bbddabff7cf5006123" },
        "next_step": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "required": ["task_id", "workflow_step", "status", "input_digest", "last_updated"],
      "additionalProperties": false,
      "properties": {
        "task_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[A-Z0-9]+-[0-9]{6}$" },
        "workflow_step": { "type": "integer", "minimum": 1, "maximum": 5 },
        "status": { "type": "string", "enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"] },
        "input_digest": { "type": "string", "minLength": 1 },
        "last_updated": { "type": "string", "minLength": 1 }
      }
    }
  }
}
