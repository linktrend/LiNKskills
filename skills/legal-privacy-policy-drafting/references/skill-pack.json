{
  "schema_version": "0.1",
  "skill_id": "legal-privacy-policy-drafting",
  "display_name": "Privacy Policy Drafting",
  "version": "0.1.0",
  "description": "Draft or revise a jurisdiction-aware privacy policy for a specified website, application or service from confirmed processing facts and current authoritative sources.",
  "capability_category": "privacy_policy_drafting",
  "lifecycle_state": "draft",
  "format_profile": "heavy",
  "compatible_runtime_profiles": [
    "lisa-openclaw",
    "cursor-macos"
  ],
  "min_capability_tier": "balanced",
  "provenance": {
    "author": "LiNKskills adaptation",
    "source": "Two full pinned Lawve source trees are preserved byte-for-byte in references/upstream/SOURCE-MANIFEST.json; Stephane strongest base, Malik same-task intake addition.",
    "license": "Exact source license evidence and notices retained; licensing owner determines permission."
  },
  "routing": {
    "when_to_use": "Draft or revise a jurisdiction-aware privacy policy for a specified website, application or service from confirmed processing facts and current authoritative sources.",
    "when_not_to_use": [
      "A different, distinct task is requested",
      "An unapproved external effect, final decision, signature or system mutation is required"
    ],
    "tags": [
      "legal",
      "privacy",
      "task-specific",
      "draft"
    ],
    "exclusion_rules": [
      "No invented company facts, jurisdiction, lawful basis, retention or legal authority.",
      "No policy publication, sending or system mutation."
    ],
    "ambiguity_rules": [
      "Read authorized evidence; ask only materially outcome-changing questions; complete separable work"
    ],
    "recommended_disclosure_level": 2
  },
  "execution": {
    "required_inputs": [
      {
        "name": "business_identity_and_contact",
        "description": "Confirmed controller/entity identity, address and privacy contact/DPO status; unknowns remain placeholders."
      },
      {
        "name": "product_and_user_journeys",
        "description": "Website/app/service type, account/transaction flows, audiences, features and relevant vendors."
      },
      {
        "name": "user_geographies_and_jurisdictions",
        "description": "Where users are located/targeted, entity locations and actual territorial connections, supported by evidence."
      },
      {
        "name": "data_categories_and_sources",
        "description": "Data categories, people, collection/source, sensitivity and whether children are in scope."
      },
      {
        "name": "purposes_and_basis_evidence",
        "description": "Each processing purpose and confirmed legal basis/operational evidence; never assign on behalf of the business."
      },
      {
        "name": "vendors_and_transfers",
        "description": "Processors/recipients, data locations, transfer routes and actual safeguards, if confirmed."
      },
      {
        "name": "cookies_and_platform_tools",
        "description": "Observed/supplied cookies, SDKs, analytics, advertising, AI and platform-contract disclosures."
      },
      {
        "name": "retention_and_rights_processes",
        "description": "Confirmed retention/deletion rules, rights channel, appeal/contact path and response owner."
      },
      {
        "name": "approved_template",
        "description": "Existing counsel-approved template or explicit choice to use a reference structure; template status and version."
      },
      {
        "name": "review_mode",
        "description": "Quick/batched or expert/detail review and requested policy language/output format."
      },
      {
        "name": "authority_sources_and_as_of",
        "description": "Current official primary legal sources, regulator guidance where appropriate, retrieval date and jurisdiction."
      }
    ],
    "expected_outputs": [
      {
        "name": "legal-privacy-policy-drafting_work_product",
        "description": "Policy draft plus source/currentness map, practice-to-clause reconciliation and visible gaps."
      }
    ],
    "forbidden_actions": [
      "Unapproved external effects, signatures, filings, legal commitments or source-system mutations",
      "Inventing facts, jurisdiction, legal authority, company policy or approval",
      "Exposure of confidential or personal data outside authorized scope"
    ],
    "verification_steps": [
      "Every representation in the policy maps to a confirmed practice or explicitly applicable current requirement.",
      "Jurisdiction and source currentness are reasoned before clause selection.",
      "All citations, dates, fines and legal claims trace to current authoritative sources.",
      "All unresolved facts remain visible as gaps; no unsupported privacy claim is made.",
      "The practice-to-clause reconciliation and change log are included.",
      "High-risk counsel triggers are surfaced without holding routine draft preparation."
    ],
    "completion_criteria": [
      "Draft sections and practice-to-clause reconciliation are complete or exact gaps are listed.",
      "Current source/date and jurisdiction applicability are visible.",
      "No unsupported representation or external effect."
    ],
    "known_limitations": [
      "Draft/uncertified; legal source currency must be checked at task time.",
      "No external legal research or publication interface is assumed."
    ]
  },
