      "source_task_role": "current_task_owner",
      "active_task_destination": "compliance-program-decision-review",
      "task_contract": {
        "trigger": "For an authorized decision-owner review on framework commitment/scope, an annual audit-calendar proposal, cross-framework evidence consolidation, mock-audit findings, management-review decisions, or certification-stage-1 sign-off.",
        "inputs": [
          "decision request and owner role or unknown",
          "candidate frameworks with asserted basis, scope, evidence refs",
          "authorized program source documents",
          "evidence inventory with artifact, owner, period/date, source ref",
          "proposed audit calendar with auditor role and source ref",
          "mock-audit record or explicit absence",
          "management-review record or explicit absence",
          "jurisdiction/applicability and as-of facts or explicit unknowns"
        ],
        "output": "Six-question evidence-grounded review/decision packet with gaps, trade-offs, open facts and owner options; no option is selected.",
        "non_goals": [
          "No final framework applicability or legal determination without required review",
          "No policy, budget, calendar or commitment approval",
          "No certification, audit opinion or readiness declaration",
          "No external effect or official record mutation"
        ]
      },
      "support_files_note": "The source entrypoint cites a wider Compliance OS support package. The exact pinned 14-file compliance-os skill subtree is preserved as a separate archived_support source entry below; it is not part of this active six-question task and its scripts are not invoked or callable."
