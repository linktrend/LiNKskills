{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "operating_model_source",
            "matter_identity",
            "domain",
            "parties_and_roles",
            "purpose_and_scope",
            "jurisdictions_as_evidenced",
            "related_matter_refs",
            "confidentiality_scope",
            "owner_and_status"
          ],
          "properties": {
            "operation": {
              "type": "string"
            },
            "operating_model_source": {
              "type": "string"
            },
            "matter_identity": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "parties_and_roles": {
              "type": "string"
            },
            "purpose_and_scope": {
              "type": "string"
            },
            "jurisdictions_as_evidenced": {
              "type": "string"
            },
            "related_matter_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidentiality_scope": {
              "type": "string"
            },
            "owner_and_status": {
              "type": "string"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_result",
            "matter_context_card",
            "open_questions",
            "isolation_boundary",
            "interface_status"
          ],
          "properties": {
            "operation_result": {
              "type": "string"
            },
            "matter_context_card": {
              "type": "object",
              "additionalProperties": true
            },
            "open_questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "isolation_boundary": {
              "type": "string"
            },
            "interface_status": {
              "type": "string"
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "completed_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
