{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agreement_ref",
            "party_roles",
            "transaction_context",
            "company_playbook_if_any",
            "governing_law_text",
            "requested_route"
          ],
          "properties": {
            "agreement_ref": {
              "type": "string"
            },
            "party_roles": {
              "type": "string"
            },
            "transaction_context": {
              "type": "string"
            },
            "company_playbook_if_any": {
              "type": "string"
            },
            "governing_law_text": {
              "type": "string"
            },
            "requested_route": {
              "type": "string"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_scope",
            "checklist_findings",
            "issue_shortlist",
            "routing_reason",
            "unresolved_questions"
          ],
          "properties": {
            "document_scope": {
              "type": "string"
            },
            "checklist_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "section",
                  "topic",
                  "status"
                ],
                "properties": {
                  "section": {
                    "type": "string"
                  },
                  "topic": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "matches_supplied_position",
                      "deviates_from_supplied_position",
                      "playbook_silent",
                      "not_assessed"
                    ]
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  }
                }
              }
            },
            "issue_shortlist": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "routing_reason": {
              "type": "string"
            },
            "unresolved_questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "completed_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
