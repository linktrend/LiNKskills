  "hard_failure_conditions": ["unowned_mutation", "unsupported_completion", "acknowledgement_inference", "health_cause_leak", "private_data_retained"],
  "evidence_policy": {"retain": ["synthetic_case_outputs", "evidence_pointers", "stable_ids"], "redact": ["secrets", "private_data", "health_causes", "reasoning", "transport_payloads"]},
