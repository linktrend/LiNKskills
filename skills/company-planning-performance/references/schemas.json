{
  "definitions": {
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["ref", "status"],
      "properties": {
        "ref": {"type": "string", "pattern": "^(fixture|source|consumer):[^\\s]+$", "maxLength": 256},
        "status": {"type": "string", "enum": ["confirmed", "reported", "not_reported"]},
        "claim": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "objective": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "evidence_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^objective:[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
        "owner_ref": {"type": "string", "pattern": "^(owner|consumer):[^\\s]+$", "maxLength": 256},
        "evidence_ref": {"type": "string", "pattern": "^(fixture|source|consumer):[^\\s]+$", "maxLength": 256}
      }
    },
    "kpi": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "unit", "evidence_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^kpi:[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "period": {"type": "string", "minLength": 1, "maxLength": 64},
        "target": {"type": ["number", "string", "null"]},
        "forecast": {"type": ["number", "string", "null"]},
        "actual": {"type": ["number", "string", "null"]},
        "precision": {"type": "string", "enum": ["whole", "one_decimal", "two_decimal", "three_decimal", "directional"]},
        "evidence_ref": {"type": "string", "pattern": "^(fixture|source|consumer):[^\\s]+$", "maxLength": 256}
      }
    },
    "signal": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "evidence_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^signal:[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"},
        "status": {"type": "string", "enum": ["on_track", "late", "blocked", "obsolete"]},
        "note": {"type": "string", "maxLength": 500},
        "evidence_ref": {"type": "string", "pattern": "^(fixture|source|consumer):[^\\s]+$", "maxLength": 256}
      }
    },
    "reprioritization": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["proposed", "PROPOSED_FOR_OWNER", "not_reported"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "objective_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^objective:[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"}},
        "evidence_ref": {"type": "string", "pattern": "^(fixture|source|consumer):[^\\s]+$", "maxLength": 256},
        "activated": {"type": "boolean", "const": false}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "privacy_classification", "plan_ref", "horizon", "period", "source_evidence", "objectives"],
      "properties": {
        "mode": {"type": "string", "enum": ["plan_review", "kpi_review", "variance_review", "reprioritization"]},
        "privacy_classification": {"type": "string", "enum": ["synthetic", "redacted", "public"]},
        "plan_ref": {"type": "string", "pattern": "^plan:[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "horizon": {"type": "string", "enum": ["monthly", "rolling_4_week", "quarterly", "annual", "three_year", "five_year"]},
        "period": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/definitions/evidence"}},
        "objectives": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/definitions/objective"}},
        "kpis": {"type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/kpi"}},
        "signals": {"type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/signal"}},
        "reprioritization": {"$ref": "#/definitions/reprioritization"},
        "requested_action": {"type": "string", "enum": ["draft", "review", "approve", "activate", "enforce", "send", "schedule", "create_task", "mutate_program", "unknown"]}
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false, "required": ["messages_sent", "external_calls", "mutations"],
      "properties": {
        "messages_sent": {"type": "array", "maxItems": 0},
        "external_calls": {"type": "array", "maxItems": 0},
        "mutations": {"type": "array", "maxItems": 0}
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false, "required": ["mutable_state_created", "duplicate_state_created"],
      "properties": {"mutable_state_created": {"type": "boolean", "const": false}, "duplicate_state_created": {"type": "boolean", "const": false}}
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "mode", "plan_ref", "horizon", "period", "objectives", "kpis", "signals", "reprioritization", "evidence", "uncertainty", "ownership", "effects", "rollback"],
      "properties": {
        "status": {"type": "string", "enum": ["READY_FOR_OWNER", "DRAFT", "BLOCKED"]},
        "mode": {"type": "string", "minLength": 1, "maxLength": 64},
        "plan_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "horizon": {"type": "string", "minLength": 1, "maxLength": 32},
        "period": {"type": "string", "minLength": 1, "maxLength": 64},
        "objectives": {"type": "array", "items": {"$ref": "#/definitions/objective"}},
        "kpis": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "unit", "period", "target", "forecast", "actual", "variance", "variance_status", "precision", "evidence_ref"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "unit": {"type": "string"}, "period": {"type": "string"}, "target": {"type": ["number", "string", "null"]}, "forecast": {"type": ["number", "string", "null"]}, "actual": {"type": ["number", "string", "null"]}, "variance": {"type": ["string", "null"]}, "variance_status": {"type": "string", "enum": ["COMPARABLE", "NOT_COMPARABLE"]}, "precision": {"type": "string"}, "evidence_ref": {"type": "string"}}}},
        "signals": {"type": "array", "items": {"$ref": "#/definitions/signal"}},
        "reprioritization": {"$ref": "#/definitions/reprioritization"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(fixture|source|consumer):[^\\s]+$"}},
        "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "ownership": {"$ref": "#/definitions/ownership"},
        "effects": {"$ref": "#/definitions/effects"},
        "rollback": {"type": "string", "const": "ABSENT@b619b3317db640d794b528ecc2afbff465f4aea9/tree:4cfcecaafa88b1fedf9096b17e305a93b8b60850"}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "workflow_step", "status", "variables", "last_updated"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "workflow_step": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"]},
        "variables": {"type": "object", "additionalProperties": false, "properties": {"request_digest": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}},
        "last_updated": {"type": "string", "format": "date-time"},
        "rollback": {"type": "string", "minLength": 1}
      }
    }
  }
}
