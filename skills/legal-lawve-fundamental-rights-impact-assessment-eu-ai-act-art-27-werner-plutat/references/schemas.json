{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {},
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system_and_classification",
            "deployer_status",
            "deployment_context",
            "rights_and_risk_evidence",
            "authority_snapshot",
            "scope_and_as_of"
          ],
          "properties": {
            "system_and_classification": {
              "type": "string",
              "description": "System/use and verified high-risk route."
            },
            "deployer_status": {
              "type": "string",
              "description": "Public-body/public-service or specified use-category facts."
            },
            "deployment_context": {
              "type": "string",
              "description": "Purpose, people affected, locations, scale, duration, human decision role."
            },
            "rights_and_risk_evidence": {
              "type": "string",
              "description": "Affected groups, foreseeable impacts, safeguards, complaints and DPIA references."
            },
            "authority_snapshot": {
              "type": "string",
              "description": "Current official Article 27 text/amendments and date."
            },
            "scope_and_as_of": {
              "type": "string",
              "description": "Applicable scope and date; state unknown rather than infer."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_type",
        "task_specific_deliverable",
        "evidence_trace",
        "uncertainties",
        "external_effects",
        "mutations"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed_draft",
            "needs_context",
            "not_applicable"
          ]
        },
        "artifact_type": {
          "const": "legal-lawve-fundamental-rights-impact-assessment-eu-ai-act-art-27-werner-plutat"
        },
        "task_specific_deliverable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicability_gates",
            "deployment_and_affected_group_map",
            "rights_risk_matrix",
            "safeguards_and_residual_risk",
            "DPIA_cross_reference",
            "notification_or_counsel_questions"
          ],
          "properties": {
            "applicability_gates": {
              "type": "string"
            },
            "deployment_and_affected_group_map": {
              "type": "string"
            },
            "rights_risk_matrix": {
              "type": "string"
            },
            "safeguards_and_residual_risk": {
              "type": "string"
            },
            "DPIA_cross_reference": {
              "type": "string"
            },
            "notification_or_counsel_questions": {
              "type": "string"
            }
          }
        },
        "evidence_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "source_ref",
              "pinpoint",
              "basis"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "pinpoint": {
                "type": "string"
              },
              "basis": {
                "enum": [
                  "verified_fact",
                  "requestor_assertion",
                  "inference",
                  "proposal",
                  "unknown"
                ]
              }
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "source_refs",
        "established_facts",
        "open_inputs",
        "next_action",
        "last_updated"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "verification",
            "complete"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "established_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
