{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_request",
            "source_documents",
            "company_context",
            "applicability_context",
            "review_owner",
            "isms_boundary",
            "audit_cycle",
            "risk_and_control_evidence",
            "auditor_roles"
          ],
          "properties": {
            "task_request": {
              "type": "string",
              "minLength": 1
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "company_context": {
              "type": "string"
            },
            "applicability_context": {
              "type": "string"
            },
            "review_owner": {
              "type": "string"
            },
            "isms_boundary": {
              "type": "string",
              "description": "Sites, services, information assets and exclusions in the stated ISMS scope."
            },
            "audit_cycle": {
              "type": "string",
              "description": "Internal, stage, surveillance or scope-change review period."
            },
            "risk_and_control_evidence": {
              "type": "string",
              "description": "Risk register, SoA, selected controls, operation evidence, management review and prior findings."
            },
            "auditor_roles": {
              "type": "string",
              "description": "Assigned auditors and their audited responsibilities."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_and_criteria",
            "risk_to_control_trace",
            "audit_coverage_plan",
            "control_sample_findings",
            "management_review_and_corrective_action_gaps"
          ],
          "properties": {
            "scope_and_criteria": {
              "type": "string",
              "description": "Task-specific draft field: scope and criteria"
            },
            "risk_to_control_trace": {
              "type": "string",
              "description": "Task-specific draft field: risk to control trace"
            },
            "audit_coverage_plan": {
              "type": "string",
              "description": "Task-specific draft field: audit coverage plan"
            },
            "control_sample_findings": {
              "type": "array",
              "description": "Task-specific draft field: control sample findings",
              "items": {
                "type": "string"
              }
            },
            "management_review_and_corrective_action_gaps": {
              "type": "array",
              "description": "Task-specific draft field: management review and corrective action gaps",
              "items": {
                "type": "string"
              }
            },
            "partial_work": {
              "type": "array",
              "description": "Separable work completed despite a material input gap; empty only when none was possible.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section",
                  "content",
                  "evidence_refs"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "missing_inputs": {
              "type": "array",
              "description": "Exact absent or inaccessible input and why it blocks the dependent conclusion.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requested_owner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "unknown_facts": {
              "type": "array",
              "description": "Facts that remain unknown or conflicting; never fill them with invented values.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "why_unknown",
                  "evidence_refs"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why_unknown": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "title": "sara-completed-draft-content",
          "if": {
            "properties": {
              "status": {
                "const": "completed_draft"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "work_product": {
                "required": [
                  "scope_and_criteria",
                  "risk_to_control_trace",
                  "audit_coverage_plan",
                  "control_sample_findings"
                ],
                "properties": {
                  "scope_and_criteria": {
                    "minLength": 1
                  },
                  "risk_to_control_trace": {
                    "minLength": 1
                  },
                  "audit_coverage_plan": {
                    "minLength": 1
                  },
                  "control_sample_findings": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "title": "sara-needs-context-record",
          "if": {
            "properties": {
              "status": {
                "const": "needs_context"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "partial_work",
                  "missing_inputs",
                  "unknown_facts"
                ],
                "properties": {
                  "missing_inputs": {
                    "minItems": 1
                  },
                  "unknown_facts": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "checkpoint_ref",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "review",
            "delivered"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "waiting_for_input",
            "completed_draft",
            "blocked"
          ]
        },
        "checkpoint_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Consumer-owner checkpoint reference; no local runtime sidecar."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
