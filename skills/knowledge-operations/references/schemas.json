{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "workstream_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision_owner_role": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "founder_interview_status": {
          "type": "string",
          "enum": [
            "not_needed",
            "complete",
            "required",
            "not_started"
          ]
        },
        "constraints_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "knowledge_inventory_and_audience",
            "owner_source_admission_metadata",
            "retrieval_and_freshness_evidence"
          ],
          "properties": {
            "knowledge_inventory_and_audience": {
              "type": "object",
              "additionalProperties": false,
              "description": "knowledge inventory and audience",
              "required": [
                "summary",
                "evidence_refs",
                "fact_status"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fact_status": {
                  "enum": [
                    "verified",
                    "principal_reported",
                    "proposed",
                    "conflicting",
                    "unknown"
                  ]
                }
              }
            },
            "owner_source_admission_metadata": {
              "type": "object",
              "additionalProperties": false,
              "description": "owner/source/admission metadata",
              "required": [
                "summary",
                "evidence_refs",
                "fact_status"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fact_status": {
                  "enum": [
                    "verified",
                    "principal_reported",
                    "proposed",
                    "conflicting",
                    "unknown"
                  ]
                }
              }
            },
            "retrieval_and_freshness_evidence": {
              "type": "object",
              "additionalProperties": false,
              "description": "retrieval and freshness evidence",
              "required": [
                "summary",
                "evidence_refs",
                "fact_status"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fact_status": {
                  "enum": [
                    "verified",
                    "principal_reported",
                    "proposed",
                    "conflicting",
                    "unknown"
                  ]
                }
              }
            }
          },
          "description": "Named evidence inputs. Unknown/conflicting inputs must be explicitly labeled; they do not become verified facts."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "NEEDS_CONTEXT",
            "PENDING_APPROVAL",
            "REFUSED",
            "FAILED"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "artifact_ref",
              "authorization_ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "authorized_draft_write"
                ]
              },
              "artifact_ref": {
                "type": "string"
              },
              "authorization_ref": {
                "type": "string"
              }
            }
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "completion_scope": {
          "type": "string",
          "minLength": 1
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knowledge_gap_and_ownership_register": {
              "type": "object",
              "additionalProperties": false,
              "description": "knowledge gap and ownership register",
              "required": [
                "summary",
                "evidence_refs",
                "artifact_refs"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "artifact_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "freshness_retrieval_improvement_plan": {
              "type": "object",
              "additionalProperties": false,
              "description": "freshness/retrieval improvement plan",
              "required": [
                "summary",
                "evidence_refs",
                "artifact_refs"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "artifact_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "librarian_intake_package": {
              "type": "object",
              "additionalProperties": false,
              "description": "Librarian intake package",
              "required": [
                "summary",
                "evidence_refs",
                "artifact_refs"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "artifact_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "description": "Named deliverable sections. COMPLETED requires every section. Partial/refused/context-needed outputs may return only completed sections."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "knowledge_gap_and_ownership_register",
                  "freshness_retrieval_improvement_plan",
                  "librarian_intake_package"
                ]
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "workflow_step",
        "status",
        "variables",
        "last_updated"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "workflow_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "type": "string",
          "enum": [
            "INITIALIZED",
            "IN_PROGRESS",
            "PENDING_APPROVAL",
            "COMPLETED",
            "FAILED"
          ]
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "variables": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string"
            },
            "data_classification": {
              "type": "string",
              "enum": [
                "synthetic",
                "redacted",
                "restricted",
                "sensitive",
                "unknown"
              ]
            },
            "source_digests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "review_status": {
              "type": "string",
              "enum": [
                "not_required",
                "required",
                "pending",
                "complete",
                "not_performed"
              ]
            }
          }
        },
        "checkpoint_ref": {
          "type": "string",
          "description": "Opaque consumer-native checkpoint ID; no raw facts or documents."
        }
      }
    }
  }
}
