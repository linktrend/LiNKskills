{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agreement_refs",
            "party_position",
            "contract_type",
            "playbook_ref",
            "deal_context",
            "deadline_and_focus"
          ],
          "properties": {
            "agreement_refs": {
              "type": "string",
              "description": "Known contract and exhibit references"
            },
            "party_position": {
              "type": "string",
              "description": "Represented party and direction of interests"
            },
            "contract_type": {
              "type": "string",
              "description": "Document/transaction type"
            },
            "playbook_ref": {
              "type": "string",
              "description": "Applicable playbook and version, or explicit none"
            },
            "deal_context": {
              "type": "string",
              "description": "Supplied business objective/leverage/facts"
            },
            "deadline_and_focus": {
              "type": "string",
              "description": "Deadline and named review focus"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_completeness",
            "key_terms",
            "clause_analysis",
            "draft_redlines_or_options",
            "issues_and_priorities",
            "gaps_and_questions",
            "authority_and_approval_boundary"
          ],
          "properties": {
            "document_completeness": {
              "type": "string",
              "description": "Page/exhibit/blank/signature checks"
            },
            "key_terms": {
              "type": "string",
              "description": "Material term extraction with section refs"
            },
            "clause_analysis": {
              "type": "string",
              "description": "Issue-level clause analysis and evidence"
            },
            "draft_redlines_or_options": {
              "type": "string",
              "description": "Proposed language/options and approval status"
            },
            "issues_and_priorities": {
              "type": "string",
              "description": "Ranked issue list and rationale"
            },
            "gaps_and_questions": {
              "type": "string",
              "description": "Unresolved facts, law, playbook or evidence"
            },
            "authority_and_approval_boundary": {
              "type": "string",
              "description": "Draft/counsel review and actions excluded"
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "completed_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
