{
  "definitions": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["ref", "status"], "properties": {"ref": {"type": "string", "pattern": "^(fixture|source|consumer):[^\\s]+$"}, "status": {"type": "string", "enum": ["confirmed", "reported", "not_reported"]}, "claim": {"type": "string", "maxLength": 500}}},
    "owner": {"type": "object", "additionalProperties": false, "required": ["responder_ref", "platform_ref", "program_ledger_ref", "deployment_authority_ref"], "properties": {"responder_ref": {"type": "string"}, "platform_ref": {"type": "string"}, "program_ledger_ref": {"type": "string"}, "deployment_authority_ref": {"type": "string"}}},
    "impact": {"type": "object", "additionalProperties": false, "required": ["id", "scope", "status", "evidence_ref"], "properties": {"id": {"type": "string", "pattern": "^impact:[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"}, "scope": {"type": "string", "maxLength": 500}, "status": {"type": "string", "enum": ["observed", "suspected", "unknown"]}, "note": {"type": "string", "maxLength": 500}, "evidence_ref": {"type": "string"}}},
