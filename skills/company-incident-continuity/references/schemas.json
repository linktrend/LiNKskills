    "closure": {"type": "object", "additionalProperties": false, "required": ["status", "activated"], "properties": {"status": {"type": "string", "enum": ["PROPOSED", "SUPPLIED", "not_reported"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "residual_risks": {"type": "array", "items": {"type": "string"}}, "owner_ref": {"type": "string"}, "activated": {"type": "boolean", "const": false}}},
    "input": {
      "type": "object", "additionalProperties": false, "required": ["mode", "privacy_classification", "incident_ref", "incident_type", "severity", "state", "owner", "source_evidence"],
      "properties": {
        "mode": {"type": "string", "enum": ["incident_intake", "outage_review", "security_coordination", "continuity_review", "recovery_decision", "closure_review"]},
        "privacy_classification": {"type": "string", "enum": ["synthetic", "redacted", "public"]},
        "incident_ref": {"type": "string", "pattern": "^incident:[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "incident_type": {"type": "string", "enum": ["outage", "security", "continuity", "data_integrity", "other"]},
        "severity": {"type": "string", "enum": ["low", "medium", "high", "critical", "unknown"]},
        "state": {"type": "string", "enum": ["detected", "triaged", "mitigating", "recovering", "monitoring", "closed", "unknown"]},
        "owner": {"$ref": "#/definitions/owner"},
        "source_evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/definitions/evidence"}},
        "impacts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/impact"}},
        "recovery_options": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/recovery_option"}},
        "communications": {"type": "array", "maxItems": 32, "items": {"type": "object"}},
        "closure": {"type": "object"},
        "requested_action": {"type": "string", "enum": ["draft", "review", "deploy", "rollback", "isolate", "rotate_credentials", "send", "approve", "close", "schedule", "mutate_program", "unknown"]}
      }
    },
    "effects": {"type": "object", "additionalProperties": false, "required": ["messages_sent", "external_calls", "mutations"], "properties": {"messages_sent": {"type": "array", "maxItems": 0}, "external_calls": {"type": "array", "maxItems": 0}, "mutations": {"type": "array", "maxItems": 0}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["incident_mutated", "program_ledger_mutated", "deployment_mutated"], "properties": {"incident_mutated": {"type": "boolean", "const": false}, "program_ledger_mutated": {"type": "boolean", "const": false}, "deployment_mutated": {"type": "boolean", "const": false}}},
    "output": {
