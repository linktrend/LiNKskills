      "properties": {
        "status": {"type": "string", "enum": ["READY_FOR_OWNER", "DRAFT", "BLOCKED"]}, "mode": {"type": "string"}, "incident_ref": {"type": "string"}, "incident_type": {"type": "string"}, "severity": {"type": "string"}, "state": {"type": "string"}, "owner": {"$ref": "#/definitions/owner"}, "impacts": {"type": "array", "items": {"$ref": "#/definitions/impact"}}, "recovery_options": {"type": "array", "items": {"$ref": "#/definitions/recovery_option"}}, "communications": {"type": "array", "items": {"$ref": "#/definitions/communication"}}, "closure": {"$ref": "#/definitions/closure"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "ownership": {"$ref": "#/definitions/ownership"}, "effects": {"$ref": "#/definitions/effects"}, "rollback": {"type": "string", "const": "ABSENT@cb5a7d469a64b49b141893359ff72cb65fba998c/tree:8e92f50bdfda1ac61035fa10444b519d5f2aebb2"}
      }
    },
    "state": {"type": "object", "additionalProperties": false, "required": ["task_id", "workflow_step", "status", "variables", "last_updated"], "properties": {"task_id": {"type": "string"}, "workflow_step": {"type": "string"}, "status": {"type": "string", "enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"]}, "variables": {"type": "object", "additionalProperties": false}, "last_updated": {"type": "string", "format": "date-time"}}}
