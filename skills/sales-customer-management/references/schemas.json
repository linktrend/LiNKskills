{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sales and Customer Management contracts",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "workflow",
        "source_evidence",
        "authority",
        "privacy_classification"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^scm-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "workflow": {
          "type": "string",
          "enum": [
            "lead_intake",
            "qualification",
            "pipeline",
            "proposal_follow_up",
            "onboarding",
            "renewal_risk",
            "founder_escalation",
            "other"
          ]
        },
        "source_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          },
          "minItems": 1
        },
        "authority": {
          "type": "object",
          "required": [
            "status",
            "owner"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "provisional",
                "not_reported"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "approved_actions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "read",
                  "prepare",
                  "write"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "privacy_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted"
          ]
        },
        "other_specify": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "lead_ref": {
          "type": "string",
          "pattern": "^lead-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "priority_signals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "urgency",
            "impact",
            "readiness"
          ],
          "properties": {
            "urgency": {"type": "integer", "minimum": 0, "maximum": 2},
            "impact": {"type": "integer", "minimum": 0, "maximum": 2},
            "readiness": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "ref",
        "claim",
        "status",
        "provenance",
        "licence"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "status": {
          "enum": [
            "confirmed",
            "inferred",
            "not_reported"
          ]
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "workflow",
        "decision",
        "disposition",
        "idempotency_key",
        "evidence_refs",
        "next_actions",
        "escalation",
        "effects",
        "qualification",
        "priority",
        "handoff",
        "rollback"
      ],
      "properties": {
        "status": {
          "enum": [
            "INITIALIZED",
            "IN_PROGRESS",
            "PENDING_APPROVAL",
            "COMPLETED",
            "FAILED"
          ]
        },
        "workflow": {
          "type": "string",
          "enum": [
            "lead_intake",
            "qualification",
            "pipeline",
            "proposal_follow_up",
            "onboarding",
            "renewal_risk",
            "founder_escalation",
            "other"
          ]
        },
        "decision": {
          "type": "object",
          "required": [
            "disposition",
            "rationale",
            "confidence"
          ],
          "properties": {
            "disposition": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "enum": [
                "high",
                "medium",
                "low",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^scm-[a-f0-9]{16}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escalation": {
          "type": "object",
          "required": [
            "required",
            "reason",
            "owner"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "effects": {
          "type": "object",
          "required": [
            "sent",
            "applied",
            "mutated_records"
          ],
          "properties": {
            "sent": {
              "const": false
            },
            "applied": {
              "const": false
            },
            "mutated_records": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "rollback": {
          "const": "ABSENT@c89bad5ce3bc91340cf388b923d2befecb406546/tree:9d0be7cedb0fc4ec42bf382735ede36d100f8614"
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "basis"
          ],
          "properties": {
            "status": {
              "enum": [
                "unqualified",
                "needs-evidence",
                "qualified",
                "disqualified",
                "escalate"
              ]
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "priority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "basis"
          ],
          "properties": {
            "level": {
              "enum": [
                "high",
                "medium",
                "low",
                "unranked"
              ]
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "recipient",
            "conversion_ref",
            "accepted"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "recipient": {
              "const": "LiNKclient"
            },
            "conversion_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "accepted": {
              "const": false
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "workflow_step",
        "status",
        "variables",
        "last_updated"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "workflow_step": {
          "type": "string"
        },
        "status": {
          "enum": [
            "INITIALIZED",
            "IN_PROGRESS",
            "PENDING_APPROVAL",
            "COMPLETED",
            "FAILED"
          ]
        },
        "variables": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_digest": {
              "type": "string"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "owner": {
              "type": "string"
            }
          }
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "rollback": {
          "type": "string"
        }
      }
    }
  }
}
