{
  "definitions": {
    "input": {
      "type": "object",
      "required": ["period", "currency", "observations", "data_classification"],
      "properties": {
        "period": { "type": "string", "minLength": 3 },
        "currency": { "type": "string", "minLength": 3 },
        "observations": { "type": "array" },
        "data_classification": { "type": "string", "enum": ["synthetic", "redacted_consumer_snapshot"] }
      }
    },
    "output": {
      "type": "object",
      "required": ["status", "findings", "approval", "provenance", "effects"],
      "properties": {
        "status": { "type": "string", "enum": ["COMPLETED", "PENDING_APPROVAL", "FAILED"] },
        "findings": { "type": "array" },
        "approval": { "type": "object" },
        "provenance": { "type": "object" },
        "effects": { "type": "object" }
      }
    },
    "state": {
      "type": "object",
      "required": ["task_id", "workflow_step", "status", "last_updated"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$" },
        "workflow_step": { "type": "integer", "minimum": 1, "maximum": 5 },
        "status": { "type": "string", "enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"] },
        "last_updated": { "type": "string" }
      }
    }
  }
}
