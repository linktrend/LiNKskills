{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode_and_goal",
            "source_records",
            "objectives_and_scope",
            "owners_and_dates",
            "output_destination",
            "scope_and_as_of"
          ],
          "properties": {
            "mode_and_goal": {
              "type": "string",
              "description": "Create, update, correspondence extraction, contextual risk discovery or escalation."
            },
            "source_records": {
              "type": "string",
              "description": "Authorized notes/emails/register snapshot with date and provenance."
            },
            "objectives_and_scope": {
              "type": "string",
              "description": "Matter/project goals, agreed scope and known constraints."
            },
            "owners_and_dates": {
              "type": "string",
              "description": "Named owner, due dates, status and existing identifiers if supplied."
            },
            "output_destination": {
              "type": "string",
              "description": "Requested draft table/report location; no system update without authorization."
            },
            "scope_and_as_of": {
              "type": "string",
              "description": "Actual scope, jurisdiction and as-of date if relevant; state unknown rather than infer."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_type",
        "task_specific_deliverable",
        "evidence_trace",
        "uncertainties",
        "external_effects",
        "mutations"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed_draft",
            "needs_context",
            "not_applicable"
          ]
        },
        "artifact_type": {
          "const": "legal-lawve-risk-and-issues-manager-scott-margetts"
        },
        "task_specific_deliverable": {
          "type": "object",
          "minProperties": 1
        },
        "evidence_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim",
              "source_ref",
              "pinpoint",
              "basis"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "pinpoint": {
                "type": "string"
              },
              "basis": {
                "enum": [
                  "verified_fact",
                  "requestor_assertion",
                  "inference",
                  "proposal",
                  "unknown"
                ]
              }
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "source_refs",
        "established_facts",
        "open_inputs",
        "next_action",
        "last_updated"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "verification",
            "complete"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "established_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
