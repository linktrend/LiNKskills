{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "meeting_purpose",
            "meeting_type",
            "date_duration",
            "participants_roles",
            "agenda",
            "authorized_source_refs",
            "sara_role"
          ],
          "properties": {
            "meeting_purpose": {
              "type": "string"
            },
            "meeting_type": {
              "type": "string"
            },
            "date_duration": {
              "type": "string"
            },
            "participants_roles": {
              "type": "string"
            },
            "agenda": {
              "type": "string"
            },
            "authorized_source_refs": {
              "type": "string"
            },
            "sara_role": {
              "type": "string"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "briefing_summary",
            "agenda_plan",
            "evidence_and_open_questions",
            "decision_points",
            "action_items",
            "follow_up_owner_list"
          ],
          "properties": {
            "briefing_summary": {
              "type": "string"
            },
            "agenda_plan": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "topic",
                  "minutes"
                ],
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "owner": {
                    "type": "string"
                  }
                }
              }
            },
            "evidence_and_open_questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "decision_points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "action_items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "action",
                  "status"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "decided",
                      "proposed",
                      "open"
                    ]
                  },
                  "owner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "due_date": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source_ref": {
                    "type": "string"
                  }
                }
              }
            },
            "follow_up_owner_list": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "completed_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
