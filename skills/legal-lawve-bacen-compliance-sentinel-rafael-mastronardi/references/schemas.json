{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "institution_and_activities",
            "regulatory_topics",
            "control_evidence",
            "service_and_data_flow",
            "current_authority_refs",
            "scope_and_as_of"
          ],
          "properties": {
            "institution_and_activities": {
              "type": "string",
              "description": "Entity type, regulated activities and verified supervisory status."
            },
            "regulatory_topics": {
              "type": "string",
              "description": "Requested topics: cybersecurity, third-party risk, Open Finance, Pix, incidents, sanctions or other."
            },
            "control_evidence": {
              "type": "string",
              "description": "Policies, control records, contracts, incident logs and system evidence."
            },
            "service_and_data_flow": {
              "type": "string",
              "description": "Provider, data location, critical data and customer-consent flow."
            },
            "current_authority_refs": {
              "type": "string",
              "description": "Current official BCB/CMN texts, as-of date and effective status."
            },
            "scope_and_as_of": {
              "type": "string",
              "description": "Actual scope, jurisdiction and as-of date if relevant; state unknown rather than infer."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_type",
        "task_specific_deliverable",
        "evidence_trace",
        "uncertainties",
        "external_effects",
        "mutations"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed_draft",
            "needs_context",
            "not_applicable"
          ]
        },
        "artifact_type": {
          "const": "legal-lawve-bacen-compliance-sentinel-rafael-mastronardi"
        },
        "task_specific_deliverable": {
          "type": "object",
          "minProperties": 1
        },
        "evidence_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim",
              "source_ref",
              "pinpoint",
              "basis"
            ],
            "properties": {
              "claim": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "pinpoint": {
                "type": "string"
              },
              "basis": {
                "enum": [
                  "verified_fact",
                  "requestor_assertion",
                  "inference",
                  "proposal",
                  "unknown"
                ]
              }
            }
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "source_refs",
        "established_facts",
        "open_inputs",
        "next_action",
        "last_updated"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "verification",
            "complete"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "established_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
