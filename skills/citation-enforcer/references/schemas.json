{
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "claim_text"],
            "properties": {
              "claim_id": { "type": "string" },
              "claim_text": { "type": "string", "minLength": 3 },
              "source_type": { "type": "string", "enum": ["memory", "search", "file"] },
              "source_pointer": { "type": "string" },
              "source_pointers": { "type": "array", "items": { "type": "string" } },
              "rel": { "type": "string", "enum": ["supports", "contradicts", "qualifies", "cites"] },
              "confidence": { "type": ["string", "number"] },
              "circular": { "type": "boolean" },
              "supersedes_claim_id": { "type": "string" },
              "evidence_class": { "type": "string" }
            }
          }
        },
        "claim_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "rel", "target_kind", "target_id"],
            "properties": {
              "claim_id": { "type": "string" },
              "rel": { "type": "string", "enum": ["supports", "contradicts", "qualifies", "cites"] },
              "target_kind": { "type": "string", "enum": ["source-version", "evidence-excerpt", "claim"] },
              "target_id": { "type": "string" }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "citations"],
      "properties": {
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED"] },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "source_type", "source_pointer"],
            "properties": {
              "claim_id": { "type": "string" },
              "source_type": { "type": "string", "enum": ["memory", "search", "file"] },
              "source_pointer": { "type": "string" },
              "rel": { "type": "string", "enum": ["supports", "contradicts", "qualifies", "cites"] },
              "negative_evidence": { "type": "string", "enum": ["missing", "observed_absence", "observed_presence"] },
              "confidence": { "type": ["string", "number"] }
            }
          }
        },
        "errors": { "type": "array", "items": { "type": "string" } },
        "blocked": { "type": "boolean" },
        "claim_ids": { "type": "array", "items": { "type": "string" } },
        "external_calls": { "type": "array", "maxItems": 0 },
        "mutations": { "type": "array", "maxItems": 0 }
      }
    },
    "state": {
      "type": "object",
      "required": ["task_id", "workflow_step", "status", "variables", "last_updated"],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "workflow_step": { "type": "integer", "minimum": 1, "maximum": 5 },
        "status": {
          "type": "string",
          "enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"]
        },
        "variables": { "type": "object" },
        "last_updated": { "type": "string" },
        "seek_index": { "type": "object" }
      }
    }
  }
}
