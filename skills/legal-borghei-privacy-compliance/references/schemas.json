{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_request",
            "source_documents",
            "company_context",
            "applicability_context",
            "review_owner",
            "processing_and_territories",
            "privacy_frameworks",
            "privacy_controls",
            "dpa_and_dsr_cases",
            "regulatory_authorities"
          ],
          "properties": {
            "task_request": {
              "type": "string",
              "minLength": 1
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "company_context": {
              "type": "string"
            },
            "applicability_context": {
              "type": "string"
            },
            "review_owner": {
              "type": "string"
            },
            "processing_and_territories": {
              "type": "string",
              "description": "Processing activities, subjects, data, locations and roles."
            },
            "privacy_frameworks": {
              "type": "string",
              "description": "Potential regimes and reason they may apply."
            },
            "privacy_controls": {
              "type": "string",
              "description": "Notice/consent, rights, retention, security, transfers and processor evidence."
            },
            "dpa_and_dsr_cases": {
              "type": "string",
              "description": "Relevant DPA/DSR evidence and status."
            },
            "regulatory_authorities": {
              "type": "string",
              "description": "Current primary rules/guidance and dates, if supplied."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_and_regime_matrix",
            "processing_control_gaps",
            "dpa_review_questions",
            "rights_process_findings",
            "transfer_and_retention_issues",
            "owner_remediation_plan"
          ],
          "properties": {
            "scope_and_regime_matrix": {
              "type": "string",
              "description": "Task-specific draft field: scope and regime matrix"
            },
            "processing_control_gaps": {
              "type": "array",
              "description": "Task-specific draft field: processing control gaps",
              "items": {
                "type": "string"
              }
            },
            "dpa_review_questions": {
              "type": "array",
              "description": "Task-specific draft field: dpa review questions",
              "items": {
                "type": "string"
              }
            },
            "rights_process_findings": {
              "type": "array",
              "description": "Task-specific draft field: rights process findings",
              "items": {
                "type": "string"
              }
            },
            "transfer_and_retention_issues": {
              "type": "array",
              "description": "Task-specific draft field: transfer and retention issues",
              "items": {
                "type": "string"
              }
            },
            "owner_remediation_plan": {
              "type": "string",
              "description": "Task-specific draft field: owner remediation plan"
            },
            "partial_work": {
              "type": "array",
              "description": "Separable work completed despite a material input gap; empty only when none was possible.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section",
                  "content",
                  "evidence_refs"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "missing_inputs": {
              "type": "array",
              "description": "Exact absent or inaccessible input and why it blocks the dependent conclusion.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requested_owner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "unknown_facts": {
              "type": "array",
              "description": "Facts that remain unknown or conflicting; never fill them with invented values.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "why_unknown",
                  "evidence_refs"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why_unknown": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "title": "sara-completed-draft-content",
          "if": {
            "properties": {
              "status": {
                "const": "completed_draft"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "work_product": {
                "required": [
                  "scope_and_regime_matrix",
                  "rights_process_findings",
                  "transfer_and_retention_issues",
                  "owner_remediation_plan"
                ],
                "properties": {
                  "scope_and_regime_matrix": {
                    "minLength": 1
                  },
                  "rights_process_findings": {
                    "minItems": 1
                  },
                  "transfer_and_retention_issues": {
                    "minItems": 1
                  },
                  "owner_remediation_plan": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "title": "sara-needs-context-record",
          "if": {
            "properties": {
              "status": {
                "const": "needs_context"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "partial_work",
                  "missing_inputs",
                  "unknown_facts"
                ],
                "properties": {
                  "missing_inputs": {
                    "minItems": 1
                  },
                  "unknown_facts": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "checkpoint_ref",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "review",
            "delivered"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "waiting_for_input",
            "completed_draft",
            "blocked"
          ]
        },
        "checkpoint_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Consumer-owner checkpoint reference; no local runtime sidecar."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
