{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trading-position-sizing task contract draft",
  "type": "object",
  "definitions": {
    "input": {
      "type": "object",
      "properties": {
        "instrument": {
          "type": "string",
          "minLength": 1,
          "description": "Instrument or contract identity."
        },
        "side": {
          "enum": [
            "long",
            "short"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "nav": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Portfolio NAV amount in nav_currency."
        },
        "nav_currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "risk_budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Risk budget in nav_currency when basis is nav_currency_amount; otherwise a fraction of NAV from 0 to 1."
        },
        "risk_budget_basis": {
          "enum": [
            "nav_currency_amount",
            "fraction_of_nav"
          ]
        },
        "entry": {
          "type": [
            "number",
            "null"
          ],
          "description": "Entry quote price per underlying unit; for a futures contract this is index points per contract underlying, not cash per contract."
        },
        "stop": {
          "type": [
            "number",
            "null"
          ],
          "description": "Stop quote price per underlying unit."
        },
        "multiplier": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Quote-currency cash per one price_unit move per one position unit (one share or one contract). For index futures, e.g. USD 5 per index_point per contract."
        },
        "fx_to_nav": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "quote_currency": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Must equal input.quote_currency."
                },
                "nav_currency": {
                  "type": "string",
                  "minLength": 1
                },
                "convention": {
                  "const": "nav_currency_per_quote_currency"
                },
                "as_of": {
                  "type": "string",
                  "format": "date-time"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "rate",
                "quote_currency",
                "nav_currency",
                "convention",
                "as_of",
                "source"
              ]
            }
          ],
          "description": "Use null only when quote_currency equals nav_currency; otherwise provide NAV-currency units per one quote-currency unit with source and timestamp."
        },
        "lot_step": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Quantity increment in position units (e.g., 1 contract or 0.01 share)."
        },
        "tick_size": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Minimum quote-price increment, in price units."
        },
        "cost_per_unit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "const": "cash_per_position_unit_round_trip"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "amount",
                "currency",
                "basis",
                "source"
              ]
            }
          ],
          "description": "Round-trip cash cost per one share/contract, not per lot or total position. Currency must equal nav_currency or quote_currency."
        },
        "gap_stress": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "basis": {
                  "const": "additional_adverse_quote_price_units_beyond_stop"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "price_unit": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Must equal input.price_unit."
                }
              },
              "required": [
                "amount",
                "price_unit",
                "basis",
                "source"
              ]
            }
          ],
          "description": "Additional adverse price_unit units beyond the stop per underlying unit; converted through multiplier and FX, not an amount of cash."
        },
        "caps": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "max_quantity": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_exposure_nav": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_nav_fraction": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "volatility_scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "risk_per_unit_nav": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "quantity": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "price_unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Quote-price unit per underlying unit (for example index_point or USD_per_share). This is not a cash currency."
        },
        "quote_currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Cash currency paid/received for the contract multiplier; separate from the quote-price unit."
        }
      },
      "required": [
        "instrument",
        "side"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "needs_input",
            "blocked"
          ]
        },
        "unit_loss": {
          "type": "object",
          "properties": {
            "side": {
              "enum": [
                "long",
                "short"
              ]
            },
            "entry": {
              "type": [
                "number",
                "null"
              ]
            },
            "stop": {
              "type": [
                "number",
                "null"
              ]
            },
            "distance_quote_price_units": {
              "type": [
                "number",
                "null"
              ]
            },
            "multiplier_quote_cash_per_price_unit_per_position_unit": {
              "type": [
                "number",
                "null"
              ]
            },
            "fx_nav_per_quote": {
              "type": [
                "number",
                "null"
              ]
            },
            "stop_loss_nav_currency_per_unit": {
              "type": [
                "number",
                "null"
              ]
            },
            "cost_amount_per_unit": {
              "type": [
                "number",
                "null"
              ]
            },
            "cost_currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "gap_beyond_stop_quote_price_units": {
              "type": [
                "number",
                "null"
              ]
            },
            "gap_loss_nav_currency_per_unit": {
              "type": [
                "number",
                "null"
              ]
            },
            "total_stressed_loss_nav_currency_per_unit": {
              "type": [
                "number",
                "null"
              ]
            },
            "nav_currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "formula": {
              "type": "string"
            },
            "price_unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "quote_currency": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "side",
            "entry",
            "stop",
            "distance_quote_price_units",
            "price_unit",
            "quote_currency",
            "multiplier_quote_cash_per_price_unit_per_position_unit",
            "fx_nav_per_quote",
            "stop_loss_nav_currency_per_unit",
            "cost_amount_per_unit",
            "cost_currency",
            "gap_beyond_stop_quote_price_units",
            "gap_loss_nav_currency_per_unit",
            "total_stressed_loss_nav_currency_per_unit",
            "nav_currency",
            "formula"
          ],
          "additionalProperties": false
        },
        "risk_budget_nav": {
          "type": [
            "number",
            "null"
          ]
        },
        "raw_quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "rounded_quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "recomputed_risk_nav": {
          "type": [
            "number",
            "null"
          ]
        },
        "binding_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenario_table": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "string"
              },
              "risk_per_unit_nav": {
                "type": "number",
                "minimum": 0
              },
              "quantity": {
                "type": "number",
                "minimum": 0
              },
              "total_risk_nav": {
                "type": "number",
                "minimum": 0
              },
              "remaining_budget_nav": {
                "type": "number"
              },
              "nav_currency": {
                "type": "string"
              }
            },
            "required": [
              "scenario",
              "risk_per_unit_nav",
              "quantity",
              "total_risk_nav",
              "remaining_budget_nav",
              "nav_currency"
            ],
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisory_proposal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "proposal": {
                  "type": "string"
                },
                "approval_required": {
                  "const": true
                },
                "basis": {
                  "type": "string"
                },
                "uncertainty": {
                  "type": "string"
                }
              },
              "required": [
                "proposal",
                "approval_required",
                "basis",
                "uncertainty"
              ],
              "additionalProperties": false
            }
          ]
        },
        "owner_handoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "unit_loss",
        "risk_budget_nav",
        "raw_quantity",
        "rounded_quantity",
        "recomputed_risk_nav",
        "binding_constraints",
        "scenario_table",
        "assumptions",
        "gaps",
        "advisory_proposal",
        "owner_handoffs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "gaps": {
                "maxItems": 0
              },
              "risk_budget_nav": {
                "type": "number"
              },
              "raw_quantity": {
                "type": "number"
              },
              "rounded_quantity": {
                "type": "number"
              },
              "recomputed_risk_nav": {
                "type": "number"
              },
              "unit_loss": {
                "properties": {
                  "entry": {
                    "type": "number"
                  },
                  "stop": {
                    "type": "number"
                  },
                  "distance_quote_price_units": {
                    "type": "number"
                  },
                  "multiplier_quote_cash_per_price_unit_per_position_unit": {
                    "type": "number"
                  },
                  "fx_nav_per_quote": {
                    "type": "number"
                  },
                  "stop_loss_nav_currency_per_unit": {
                    "type": "number"
                  },
                  "cost_amount_per_unit": {
                    "type": "number"
                  },
                  "cost_currency": {
                    "type": "string"
                  },
                  "gap_beyond_stop_quote_price_units": {
                    "type": "number"
                  },
                  "gap_loss_nav_currency_per_unit": {
                    "type": "number"
                  },
                  "total_stressed_loss_nav_currency_per_unit": {
                    "type": "number"
                  },
                  "nav_currency": {
                    "type": "string"
                  },
                  "price_unit": {
                    "type": "string"
                  },
                  "quote_currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "entry",
                  "stop",
                  "distance_quote_price_units",
                  "price_unit",
                  "quote_currency",
                  "multiplier_quote_cash_per_price_unit_per_position_unit",
                  "fx_nav_per_quote",
                  "stop_loss_nav_currency_per_unit",
                  "cost_amount_per_unit",
                  "cost_currency",
                  "gap_beyond_stop_quote_price_units",
                  "gap_loss_nav_currency_per_unit",
                  "total_stressed_loss_nav_currency_per_unit",
                  "nav_currency"
                ]
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "in_progress",
            "completed",
            "needs_input",
            "blocked"
          ]
        },
        "open_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  }
}
