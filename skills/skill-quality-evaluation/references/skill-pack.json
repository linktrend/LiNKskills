{
  "schema_version": "0.1",
  "skill_id": "skill-quality-evaluation",
  "display_name": "Skill Quality Evaluation",
  "version": "0.1.0",
  "description": "Evaluate a pinned skill release against frozen task cases, trigger behavior and typed output assertions; deliver bounded evidence and revision recommendations.",
  "capability_category": "task_specific_operations",
  "lifecycle_state": "draft",
  "format_profile": "heavy",
  "compatible_runtime_profiles": [
    "lisa-openclaw",
    "cursor-macos"
  ],
  "min_capability_tier": "balanced",
  "provenance": {
    "author": "LiNKskills adaptation",
    "source": "anthropics/skills@8a1541c4a3ffa5a20a5a91de0dcf3f0bab1d1ef4:skills/skill-creator/SKILL.md",
    "license": "Source notices and license evidence retained in references/upstream/SOURCE-MANIFEST.json; licensing review is separate."
  },
  "routing": {
    "when_to_use": "Evaluate a pinned skill release using frozen cases and supplied or owner-authorized evaluation evidence.",
    "when_not_to_use": [
      "A distinct task is requested",
      "Live system mutation, external message, paid run, or final approval is requested"
    ],
    "tags": [
      "task-specific",
      "draft"
    ],
    "exclusion_rules": [
      "No invented facts, results, approval or current-law applicability",
      "No external side effect or source-system write"
    ],
    "ambiguity_rules": [
      "Use authorized read evidence; finish separable work and name exact missing inputs"
    ],
    "recommended_disclosure_level": 2
  },
  "execution": {
    "required_inputs": [
      {
        "name": "task_request",
        "description": "Exact requested task and limits."
      },
      {
        "name": "skill_quality_evaluation_payload",
        "description": "Typed task-specific source inputs."
      }
    ],
    "expected_outputs": [
      {
        "name": "skill_quality_evaluation_work_product",
        "description": "Distinct task-specific draft per the contract."
      }
    ],
    "forbidden_actions": [
      "Unapproved external effects, source-system writes or messages",
      "Inventing facts, applicability, approvals or conclusions",
      "Exposing private data outside authorized scope"
    ],
    "verification_steps": [
      "Validate typed input/output contract and every task-specific acceptance criterion.",
      "Tie factual claims to supplied evidence and preserve missing data.",
      "Keep external_effects and mutations empty.",
      "Use current native schemas only."
    ],
    "completion_criteria": [
      "Distinct task output is present and traceable.",
      "Known gaps and accountable owner are clear.",
      "No external effect or mutation was performed."
    ],
    "known_limitations": [
      "Draft and uncertified; no live semantic evaluation claimed",
      "Current company facts, legal applicability or system state are not assumed"
    ]
  },
