{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:linkskills:trading-technical-chart-analysis:0.1.0",
  "title": "Technical chart reading",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "symbol",
        "source",
        "as_of",
        "timeframe",
        "timezone",
        "evidence_mode"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "timeframe": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "evidence_mode": {
          "enum": [
            "chart_image",
            "ohlcv_bars",
            "contrarian_checklist"
          ]
        },
        "adjustment_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "timestamp",
              "open",
              "high",
              "low",
              "close",
              "volume",
              "price_unit",
              "volume_unit"
            ],
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "open": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "close": {
                "type": "number"
              },
              "volume": {
                "type": "number",
                "minimum": 0
              },
              "price_unit": {
                "type": "string"
              },
              "volume_unit": {
                "type": "string"
              }
            }
          }
        },
        "chart_observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "crowd_direction": {
          "enum": [
            "CROWDED_LONG",
            "CROWDED_SHORT"
          ]
        },
        "requested_indicators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "completion_status",
        "symbol",
        "as_of",
        "timeframe",
        "observations",
        "levels",
        "scenarios",
        "countercase",
        "limitations",
        "missing_inputs"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "completion_status": {
          "enum": [
            "complete",
            "partial",
            "insufficient_input"
          ]
        },
        "symbol": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "timeframe": {
          "type": "string"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "evidence",
              "classification"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "classification": {
                "enum": [
                  "observation",
                  "calculation",
                  "interpretation"
                ]
              }
            }
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "price",
              "unit",
              "evidence"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "support",
                  "resistance",
                  "invalidation"
                ]
              },
              "price": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "interpretation",
              "invalidation"
            ],
            "properties": {
              "condition": {
                "type": "string"
              },
              "interpretation": {
                "type": "string"
              },
              "invalidation": {
                "type": "string"
              },
              "probability_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "countercase": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
