{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:linkskills:trading-breakout-momentum-strategy:0.1.0",
  "title": "Breakout and momentum research contract",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "variant",
        "as_of_date",
        "universe_snapshot",
        "venue_calendar",
        "source_snapshot",
        "bar_policy",
        "parameters",
        "bars",
        "events",
        "controls"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "vcp",
            "momentum_burst",
            "episodic_pivot",
            "twenty_pct_event_study",
            "squeeze_pullback"
          ]
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "universe_snapshot": {
          "type": "string"
        },
        "venue_calendar": {
          "type": "string"
        },
        "source_snapshot": {
          "type": "string"
        },
        "bar_policy": {
          "type": "string"
        },
        "benchmark": {
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "bars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "date",
              "open",
              "high",
              "low",
              "close",
              "volume",
              "price_unit",
              "volume_unit",
              "source_row"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "open": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "close": {
                "type": "number"
              },
              "volume": {
                "type": "number",
                "minimum": 0
              },
              "price_unit": {
                "type": "string"
              },
              "volume_unit": {
                "type": "string"
              },
              "source_row": {
                "type": "string"
              },
              "adjusted": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "event_type",
              "published_at",
              "source"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "event_type": {
                "type": "string"
              },
              "published_at": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "controls": {
          "type": "object"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "variant",
        "as_of_date",
        "universe_coverage",
        "candidates",
        "cohort_summary",
        "method_limits",
        "gaps",
        "advisory_only"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "needs_input",
            "blocked"
          ]
        },
        "variant": {
          "enum": [
            "vcp",
            "momentum_burst",
            "episodic_pivot",
            "twenty_pct_event_study",
            "squeeze_pullback"
          ]
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "universe_coverage": {
          "type": "object"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "symbol",
              "classification",
              "evidence",
              "matched_parameters",
              "invalidation",
              "source_rows"
            ],
            "properties": {
              "symbol": {
                "type": "string"
              },
              "classification": {
                "enum": [
                  "candidate",
                  "watch",
                  "reject",
                  "insufficient_data"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "matched_parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "invalidation": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source_rows": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "counterevidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "cohort_summary": {
          "type": [
            "object",
            "null"
          ]
        },
        "method_limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisory_only": {
          "const": true
        }
      }
    }
  }
}
