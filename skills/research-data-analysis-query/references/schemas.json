{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research-data-analysis-query task contract draft",
  "type": "object",
  "definitions": {
    "input": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "data_ref": {
          "type": "string"
        },
        "schema": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "table",
            "columns"
          ],
          "additionalProperties": false
        },
        "dialect": {
          "type": "string"
        },
        "definitions": {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        "units": {
          "type": "string"
        },
        "time_range": {
          "type": "string"
        },
        "population": {
          "type": "string"
        },
        "permissions": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "data_ref",
        "schema",
        "dialect",
        "definitions",
        "units",
        "time_range",
        "population",
        "permissions"
      ],
      "additionalProperties": false,
      "title": "Task-specific input"
    },
    "output": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "as_of": {
              "type": "string"
            },
            "row_count": {
              "type": "integer"
            }
          },
          "required": [
            "source",
            "as_of",
            "row_count"
          ],
          "additionalProperties": false
        },
        "query": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "filters_and_joins": {
          "type": "object",
          "properties": {
            "filters": {
              "type": "string"
            },
            "joins": {
              "type": "string"
            }
          },
          "required": [
            "filters",
            "joins"
          ],
          "additionalProperties": false
        },
        "result_counts": {
          "type": "object",
          "properties": {
            "rows_returned": {
              "type": "integer"
            },
            "source_rows_in_period": {
              "type": "integer"
            }
          },
          "required": [
            "rows_returned",
            "source_rows_in_period"
          ],
          "additionalProperties": false
        },
        "profile_and_quality": {
          "type": "object",
          "properties": {
            "duplicate_event_ids": {
              "type": "integer"
            },
            "null_categories": {
              "type": "number"
            },
            "units": {
              "type": "string"
            }
          },
          "required": [
            "duplicate_event_ids",
            "null_categories",
            "units"
          ],
          "additionalProperties": false
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "n": {
                "type": "integer"
              }
            },
            "required": [
              "category",
              "n"
            ],
            "additionalProperties": false
          }
        },
        "interpretation": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "provenance",
        "query",
        "parameters",
        "filters_and_joins",
        "result_counts",
        "profile_and_quality",
        "results",
        "interpretation",
        "limitations"
      ],
      "additionalProperties": false,
      "title": "Task-specific result"
    },
    "state": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "in_progress",
            "completed",
            "needs_input",
            "blocked"
          ]
        },
        "open_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  }
}
