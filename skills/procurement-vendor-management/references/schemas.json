{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Procurement and Vendor Management contracts",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "workflow", "source_evidence", "authority", "privacy_classification"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^pvm-[a-z0-9-]+$"},
        "workflow": {"type": "string", "enum": ["supplier_intake", "supplier_comparison", "pricing_verification", "contract_review", "renewal_review", "performance_review", "continuity_risk", "approval_brief", "other"]},
        "supplier_ref": {"type": "string", "pattern": "^supplier-[a-z0-9-]+$"},
        "source_evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}, "minItems": 1},
        "authority": {"type": "object", "required": ["status", "owner"], "properties": {"status": {"enum": ["confirmed", "provisional", "not_reported"]}, "owner": {"type": "string"}, "approved_actions": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "prepare", "compare"]}}}, "additionalProperties": false},
        "requested_actions": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "prepare", "compare", "approve", "order", "accept", "send", "negotiate", "renew", "terminate", "mutate"]}},
        "privacy_classification": {"type": "string", "enum": ["synthetic", "redacted", "restricted"]},
        "privilege_status": {"type": "string", "enum": ["not_claimed", "owner_marked", "unknown"]},
        "other_specify": {"type": "string", "maxLength": 240}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["ref", "claim", "status", "provenance", "licence"],
      "properties": {"ref": {"type": "string"}, "claim": {"type": "string", "maxLength": 500}, "status": {"enum": ["confirmed", "inferred", "not_reported"]}, "provenance": {"type": "string"}, "licence": {"type": "string"}, "source_kind": {"enum": ["official", "owner_supplied", "secondary", "unverified"]}, "retrieved_at": {"type": "string"}},
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "workflow", "decision", "disposition", "idempotency_key", "evidence_refs", "next_actions", "escalation", "effects", "rollback"],
      "properties": {
        "status": {"enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"]},
        "workflow": {"type": "string"},
        "decision": {"type": "object", "required": ["disposition", "rationale", "confidence"], "properties": {"disposition": {"type": "string"}, "rationale": {"type": "string"}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}}, "additionalProperties": false},
        "disposition": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "pattern": "^pvm-[a-f0-9]{16}$"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "next_actions": {"type": "array", "items": {"type": "string"}},
        "escalation": {"type": "object", "required": ["required", "reason", "owner"], "properties": {"required": {"type": "boolean"}, "reason": {"type": "string"}, "owner": {"type": "string"}}, "additionalProperties": false},
        "effects": {"type": "object", "required": ["sent", "accepted", "ordered", "mutated_records"], "properties": {"sent": {"const": false}, "accepted": {"const": false}, "ordered": {"const": false}, "mutated_records": {"const": false}}, "additionalProperties": false},
        "rollback": {"const": "ABSENT@c89bad5ce3bc91340cf388b923d2befecb406546/tree:9d0be7cedb0fc4ec42bf382735ede36d100f8614"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "workflow_step", "status", "variables", "last_updated"],
      "properties": {"task_id": {"type": "string", "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"}, "workflow_step": {"type": "string"}, "status": {"enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"]}, "variables": {"type": "object", "additionalProperties": false, "properties": {"request_digest": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "owner": {"type": "string"}}}, "last_updated": {"type": "string", "format": "date-time"}, "rollback": {"type": "string"}}
    }
  }
}
