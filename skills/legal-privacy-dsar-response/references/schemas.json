{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_request",
            "source_documents",
            "company_context",
            "applicability_context",
            "review_owner",
            "request_and_receipt",
            "identity_and_authority",
            "request_scope",
            "systems_and_data_map",
            "holds_exemptions_and_jurisdictions"
          ],
          "properties": {
            "task_request": {
              "type": "string",
              "minLength": 1
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "company_context": {
              "type": "string"
            },
            "applicability_context": {
              "type": "string"
            },
            "review_owner": {
              "type": "string"
            },
            "request_and_receipt": {
              "type": "string",
              "description": "Request text, received date/time and channel."
            },
            "identity_and_authority": {
              "type": "string",
              "description": "Verification evidence and representative authority status."
            },
            "request_scope": {
              "type": "string",
              "description": "Rights requested, identities, time period and requested format."
            },
            "systems_and_data_map": {
              "type": "string",
              "description": "Authorized system search results and record owners."
            },
            "holds_exemptions_and_jurisdictions": {
              "type": "string",
              "description": "Hold/retention constraints, applicable jurisdictions and verified deadline source."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_classification",
            "verification_and_scope_status",
            "search_coverage_and_data_map",
            "exemption_questions",
            "draft_acknowledgment_or_response",
            "deadline_and_counsel_escalations"
          ],
          "properties": {
            "request_classification": {
              "type": "string",
              "description": "Task-specific draft field: request classification"
            },
            "verification_and_scope_status": {
              "type": "string",
              "description": "Task-specific draft field: verification and scope status"
            },
            "search_coverage_and_data_map": {
              "type": "string",
              "description": "Task-specific draft field: search coverage and data map"
            },
            "exemption_questions": {
              "type": "array",
              "description": "Task-specific draft field: exemption questions",
              "items": {
                "type": "string"
              }
            },
            "draft_acknowledgment_or_response": {
              "type": "string",
              "description": "Task-specific draft field: draft acknowledgment or response"
            },
            "deadline_and_counsel_escalations": {
              "type": "string",
              "description": "Task-specific draft field: deadline and counsel escalations"
            },
            "partial_work": {
              "type": "array",
              "description": "Separable work completed despite a material input gap; empty only when none was possible.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section",
                  "content",
                  "evidence_refs"
                ],
                "properties": {
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "missing_inputs": {
              "type": "array",
              "description": "Exact absent or inaccessible input and why it blocks the dependent conclusion.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requested_owner": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "unknown_facts": {
              "type": "array",
              "description": "Facts that remain unknown or conflicting; never fill them with invented values.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "why_unknown",
                  "evidence_refs"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why_unknown": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "title": "sara-completed-draft-content",
          "if": {
            "properties": {
              "status": {
                "const": "completed_draft"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              },
              "work_product": {
                "required": [
                  "request_classification",
                  "verification_and_scope_status",
                  "search_coverage_and_data_map",
                  "draft_acknowledgment_or_response"
                ],
                "properties": {
                  "request_classification": {
                    "minLength": 1
                  },
                  "verification_and_scope_status": {
                    "minLength": 1
                  },
                  "search_coverage_and_data_map": {
                    "minLength": 1
                  },
                  "draft_acknowledgment_or_response": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "title": "sara-needs-context-record",
          "if": {
            "properties": {
              "status": {
                "const": "needs_context"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "partial_work",
                  "missing_inputs",
                  "unknown_facts"
                ],
                "properties": {
                  "missing_inputs": {
                    "minItems": 1
                  },
                  "unknown_facts": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "checkpoint_ref",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "review",
            "delivered"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "waiting_for_input",
            "completed_draft",
            "blocked"
          ]
        },
        "checkpoint_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Consumer-owner checkpoint reference; no local runtime sidecar."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
