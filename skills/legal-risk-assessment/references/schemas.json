{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_description",
            "factual_context",
            "source_refs",
            "existing_controls",
            "impact_dimensions",
            "likelihood_evidence",
            "approved_risk_rubric_if_any",
            "risk_owner"
          ],
          "properties": {
            "risk_description": {
              "type": "string"
            },
            "factual_context": {
              "type": "string"
            },
            "source_refs": {
              "type": "string"
            },
            "existing_controls": {
              "type": "string"
            },
            "impact_dimensions": {
              "type": "string"
            },
            "likelihood_evidence": {
              "type": "string"
            },
            "approved_risk_rubric_if_any": {
              "type": "string"
            },
            "risk_owner": {
              "type": "string"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_statement",
            "severity_likelihood_basis",
            "mitigation_options",
            "residual_risk",
            "monitoring_plan",
            "open_questions"
          ],
          "properties": {
            "risk_statement": {
              "type": "string"
            },
            "severity_likelihood_basis": {
              "type": "object",
              "required": [
                "severity",
                "likelihood",
                "rating_basis"
              ],
              "properties": {
                "severity": {
                  "type": "string"
                },
                "likelihood": {
                  "type": "string"
                },
                "rating_basis": {
                  "type": "string"
                },
                "rubric_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "mitigation_options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "option",
                  "owner",
                  "residual_effect"
                ],
                "properties": {
                  "option": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "residual_effect": {
                    "type": "string"
                  },
                  "dependency": {
                    "type": "string"
                  }
                }
              }
            },
            "residual_risk": {
              "type": "string"
            },
            "monitoring_plan": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "open_questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "completed_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
