{
  "definitions": {
    "input": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "enum": [
            "ide-development",
            "linkdeveloper-web",
            "linkdeveloper-apps",
            "linksites",
            "general"
          ],
          "type": "string"
        },
        "explicit_route": {
          "maxLength": 96,
          "type": "string"
        },
        "task": {
          "maxLength": 12000,
          "minLength": 3,
          "type": "string"
        }
      },
      "required": [
        "task",
        "consumer"
      ],
      "type": "object"
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "selected_route": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_entrypoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "SELECTED",
            "AMBIGUOUS",
            "NOT_APPLICABLE"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "selected_route",
        "source_entrypoint",
        "reason",
        "alternatives"
      ],
      "type": "object"
    }
  }
}
