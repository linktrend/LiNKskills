{
  "definitions": {
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_path",
        "sha256"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "pattern": "^skills/(?!\\.\\.?/)(?!.*\\/\\.\\.?($|/))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "review_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "path",
        "line",
        "evidence",
        "finding",
        "recommendation"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F-[0-9]{2,4}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "material",
            "critical"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^skills/(?!\\.\\.?/)(?!.*\\/\\.\\.?($|/))[A-Za-z0-9._/-]+$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "structural_receipt_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_status",
        "target_sha256"
      ],
      "properties": {
        "reported_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_ref": {
          "type": "string",
          "pattern": "^(fixture|artifact|consumer):[^\\s]+$"
        }
      }
    },
    "semantic_review_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_sha256",
        "status",
        "findings"
      ],
      "properties": {
        "reviewed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_ref": {
          "type": "string",
          "pattern": "^(owner|consumer):[^\\s]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "FINDINGS",
            "NO_FINDINGS"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/review_finding"
          }
        }
      }
    },
    "behavior_result_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_ref",
        "reported_status",
        "expected_conclusion",
        "observed_conclusion"
      ],
      "properties": {
        "scenario_ref": {
          "type": "string",
          "pattern": "^(fixture|artifact|consumer):[^\\s]+$"
        },
        "reported_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "expected_conclusion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed_conclusion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "behavior_receipt_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported_status",
        "target_sha256",
        "scenario_results"
      ],
      "properties": {
        "reported_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_ref": {
          "type": "string",
          "pattern": "^(fixture|artifact|consumer):[^\\s]+$"
        },
        "scenario_results": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/behavior_result_input"
          }
        }
      }
    },
    "refine_review_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_binding",
        "observed_target_sha256",
        "requested_disposition"
      ],
      "properties": {
        "target_binding": {
          "$ref": "#/definitions/target_binding"
        },
        "observed_target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requested_disposition": {
          "type": "string",
          "enum": [
            "PATCH_PROPOSED",
            "NO_CHANGE"
          ]
        },
        "patch_ref": {
          "type": "string",
          "pattern": "^(fixture|artifact):[^\\s]+$"
        },
        "structural_receipt": {
          "$ref": "#/definitions/structural_receipt_input"
        },
        "semantic_review": {
          "$ref": "#/definitions/semantic_review_input"
        },
        "behavior_receipt": {
          "$ref": "#/definitions/behavior_receipt_input"
        }
      }
    },
    "structural_review_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_RUN",
            "PASS_REPORTED",
            "FAIL_REPORTED",
            "MISSING_RECEIPT",
            "STALE_RECEIPT",
            "STALE_TARGET"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "checked_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_ref": {
          "type": "string",
          "pattern": "^(fixture|artifact|consumer):[^\\s]+$"
        }
      }
    },
    "semantic_review_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "findings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_REVIEWED",
            "FINDINGS_REPORTED",
            "NO_FINDINGS_REPORTED",
            "STALE_REVIEW",
            "STALE_TARGET"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_ref": {
          "type": "string",
          "pattern": "^(owner|consumer):[^\\s]+$"
        },
        "findings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/review_finding"
          }
        }
      }
    },
    "behavior_review_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "scenario_count",
        "matched_scenario_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "NOT_EVALUATED",
            "PASS_REPORTED",
            "FAIL_REPORTED",
            "MISSING_RECEIPT",
            "STALE_RECEIPT",
            "STALE_TARGET"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evaluated_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_ref": {
          "type": "string",
          "pattern": "^(fixture|artifact|consumer):[^\\s]+$"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "matched_scenario_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      }
    },
    "refine_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_binding",
        "observed_target_sha256",
        "disposition",
        "structural",
        "semantic",
        "behavior",
        "qualification"
      ],
      "properties": {
        "target_binding": {
          "$ref": "#/definitions/target_binding"
        },
        "observed_target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "PATCH_PROPOSED",
            "NO_CHANGE",
            "STALE_TARGET",
            "BLOCKED"
          ]
        },
        "patch_ref": {
          "type": "string",
          "pattern": "^(fixture|artifact):[^\\s]+$"
        },
        "structural": {
          "$ref": "#/definitions/structural_review_report"
        },
        "semantic": {
          "$ref": "#/definitions/semantic_review_report"
        },
        "behavior": {
          "$ref": "#/definitions/behavior_review_report"
        },
        "qualification": {
          "type": "string",
          "const": "NOT_CLAIMED"
        }
      }
    },
    "spec": {
      "type": "object",
      "description": "Input specification for scaffold, reverse-engineering, or refiner mode.",
      "required": ["mode", "name", "engine", "tooling"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["SCAFFOLD", "REVERSE_ENGINEER", "REFINER"],
          "description": "Architect execution mode"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Skill name in kebab-case (e.g., 'web-scraper', 'email-responder')"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "description": "Third-person summary of what the skill does"
        },
        "tools": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "description": "List of tools the skill will use (e.g., ['write_file', 'read_file', 'codebase_search'])"
        },
        "usage_trigger": {
          "type": "string",
          "description": "Explicit context for when to use this skill (e.g., 'Use when the user wants to scrape web content')"
        },
        "engine": {
          "type": "object",
          "description": "Intelligence floor requirements for the target skill runtime.",
          "required": ["min_reasoning_tier", "preferred_model", "context_required"],
          "properties": {
            "min_reasoning_tier": {
              "type": "string",
              "enum": ["fast", "balanced", "high"]
            },
            "preferred_model": { "type": "string", "minLength": 1 },
            "context_required": { "type": "integer", "minimum": 1024 }
          }
        },
        "tooling": {
          "type": "object",
          "description": "Tooling protocol requirements for the target skill.",
          "required": ["policy", "jit_enabled_if", "jit_tool_threshold", "require_get_tool_details"],
          "properties": {
            "policy": { "type": "string", "enum": ["cli-first"] },
            "jit_enabled_if": { "type": "string", "enum": ["generalist_or_gt10_tools"] },
            "jit_tool_threshold": { "type": "integer", "minimum": 1 },
            "require_get_tool_details": { "type": "boolean" }
          }
        },
        "source_artifact": {
          "type": "string",
          "description": "Third-party prompt/code source used in REVERSE_ENGINEER mode"
        },
        "improvement_drivers": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Reasons for REFINER mode updates (failures, feature requests, tool changes, quality upgrades)"
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Optional category tags (e.g., ['web', 'automation', 'data'])"
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Optional MCP server IDs or local script paths"
        },
        "permissions": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Optional permission scopes (e.g., ['fs_read', 'fs_write', 'api_access'])"
        },
        "target_binding": {"$ref": "#/definitions/target_binding", "description": "Required for REFINER; bind exact target path and digest."}
      },
      "allOf": [{"if": {"properties": {"mode": {"const": "REFINER"}}, "required": ["mode"]}, "then": {"required": ["target_binding", "improvement_drivers"], "properties": {"improvement_drivers": {"minItems": 1}}}}]
    },
    "report": {
      "type": "object",
      "description": "Output report after architect execution.",
      "required": ["status", "skill_name", "task_id", "mode", "version"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "VALIDATION_FAILED", "PARTIAL", "REFINED", "MIGRATED"]
        },
        "mode": { "type": "string", "enum": ["SCAFFOLD", "REVERSE_ENGINEER", "REFINER"] },
        "skill_name": {"type": "string"},
        "task_id": {"type": "string"},
        "version": {
          "type": "string",
          "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
        },
        "validation_errors": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of validation errors if status is VALIDATION_FAILED"
        },
        "files_created": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of file paths created during scaffolding"
        },
        "refine_review": {"$ref": "#/definitions/refine_review"}
      },
      "allOf": [{"if": {"properties": {"mode": {"const": "REFINER"}}, "required": ["mode"]}, "then": {"required": ["refine_review"]}}]
    },
    "state": {
      "type": "object",
      "description": "Validation for .workdir state persistence during skill generation.",
      "required": ["task_id", "workflow_step", "status", "last_updated", "variables"],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "workflow_step": {"type": "integer", "minimum": 0, "maximum": 5},
        "status": {
          "type": "string",
          "enum": [
            "AUDITED",
            "INITIALIZED",
            "DESIGNED",
            "SCAFFOLDED",
            "MIGRATED",
            "REFINED",
            "VALIDATED",
            "VALIDATION_FAILED",
            "COMPLETED"
          ]
        },
        "last_updated": { "type": "string" },
        "variables": {
          "type": "object",
          "description": "Mode data, specs, drafts, and validation results."
        },
        "seek_index": {
          "type": "object",
          "description": "Offsets/keys used to seek phase-specific records from state.jsonl or flat files."
        }
      }
    }
  }
}
