{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "entity_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_owner_role": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_inputs": {
          "type": "object",
          "description": "accounting software selection; accounting and erp software comparison; vendor demo evaluation sheet; accounting package quotation tracker; three year software cost comparison; Also use it when the user describes a scored evaluation of shortlisted accounting; packages before one is chosen, or the same process happening in a spreadsheet, a document; or someone inboxes."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "COMPLETED",
            "NEEDS_CONTEXT",
            "PENDING_APPROVAL",
            "REFUSED",
            "FAILED"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "artifact_ref",
              "authorization_ref"
            ],
            "properties": {
              "kind": {
                "const": "authorized_draft_write"
              },
              "artifact_ref": {
                "type": "string"
              },
              "authorization_ref": {
                "type": "string"
              }
            }
          }
        },
        "data_classification": {
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "work_product": {
          "type": "object",
          "description": "Follow the shared execution contract. The module-specific rules below define only domain fields, decisions, calculations, and safety constraints.; ### Step 1 - Identify intent; Read the request and pick the intent before asking anything.; \"set up\" or \"build\" or \"create\" -> the user wants artifacts; go to Step 2.; \"compare\" or \"which one should we pick\" -> the user wants an evaluation; capture the shortlist, then Step 2.; \"our process is ...\" or \"it is in a sheet\" -> the user wants to move an existing evaluation; capture it, then Step 2.; \"is this right\" or \"review\" or \"audit\" -> the user wants a check, not a build; answer from what they share.; \"report\" or \"how do I ...\" -> advice question; answer directly and offer the build only if it helps."
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "workflow_step",
        "status",
        "variables",
        "last_updated"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "workflow_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "enum": [
            "INITIALIZED",
            "IN_PROGRESS",
            "COMPLETED",
            "FAILED"
          ]
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "variables": {
          "type": "object",
          "properties": {
            "data_classification": {
              "enum": [
                "synthetic",
                "redacted",
                "restricted",
                "sensitive",
                "unknown"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "artifact_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "open_questions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
