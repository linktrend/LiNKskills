{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Commercial Contracts and Legal Operations contracts",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "workflow", "matter_ref", "source_evidence", "authority", "privacy_classification"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^clo-[a-z0-9-]+$"},
        "workflow": {"type": "string", "enum": ["intake", "plain_language_summary", "obligation_register", "renewal_review", "playbook_comparison", "escalation", "other"]},
        "matter_ref": {"type": "string", "pattern": "^matter-[a-z0-9-]+$"},
        "jurisdiction": {"type": "string", "maxLength": 160},
        "source_evidence": {"type": "array", "items": {"$ref": "#/definitions/evidence"}, "minItems": 1},
        "authority": {"type": "object", "required": ["status", "owner"], "properties": {"status": {"enum": ["confirmed", "provisional", "not_reported"]}, "owner": {"type": "string"}, "approved_actions": {"type": "array", "items": {"enum": ["read", "prepare", "compare"]}}}, "additionalProperties": false},
        "privacy_classification": {"type": "string", "enum": ["synthetic", "redacted", "restricted"]},
        "privilege_status": {"type": "string", "enum": ["not_claimed", "owner_marked", "unknown"]},
        "other_specify": {"type": "string", "maxLength": 240}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["ref", "claim", "status", "provenance", "licence"],
      "properties": {"ref": {"type": "string"}, "claim": {"type": "string", "maxLength": 500}, "status": {"enum": ["confirmed", "inferred", "not_reported"]}, "provenance": {"type": "string"}, "licence": {"type": "string"}, "source_kind": {"enum": ["official", "owner_supplied", "secondary", "unverified"]}, "retrieved_at": {"type": "string"}},
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": ["obligation_ref", "source_ref", "responsible_party", "action", "status", "confidence"],
      "properties": {"obligation_ref": {"type": "string"}, "source_ref": {"type": "string"}, "responsible_party": {"type": "string"}, "trigger": {"type": "string"}, "action": {"type": "string"}, "deadline": {"type": "string"}, "notice_method": {"type": "string"}, "renewal_rule": {"type": "string"}, "dependency": {"type": "string"}, "status": {"enum": ["confirmed", "inferred", "not_reported", "open"]}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}},
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "workflow", "decision", "disposition", "idempotency_key", "evidence_refs", "next_actions", "escalation", "effects", "jurisdiction_assessment"],
      "properties": {
        "status": {"enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"]},
        "workflow": {"type": "string"},
        "decision": {"type": "object", "required": ["disposition", "rationale", "confidence", "legal_authority"], "properties": {"disposition": {"type": "string"}, "rationale": {"type": "string"}, "confidence": {"enum": ["high", "medium", "low", "unknown"]}, "legal_authority": {"const": "not_granted"}}, "additionalProperties": false},
        "disposition": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "pattern": "^clo-[a-f0-9]{16}$"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "obligation_register": {"type": "array", "items": {"$ref": "#/definitions/obligation"}},
        "playbook_comparison": {"type": "array", "items": {"type": "object", "required": ["ref", "result", "evidence_refs"], "properties": {"ref": {"type": "string"}, "result": {"enum": ["match", "gap", "unclear", "not_applicable"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
        "next_actions": {"type": "array", "items": {"type": "string"}},
        "escalation": {"type": "object", "required": ["required", "reason", "owner"], "properties": {"required": {"type": "boolean"}, "reason": {"type": "string"}, "owner": {"enum": ["lawyer", "principal", "owner", "none"]}}, "additionalProperties": false},
        "jurisdiction_assessment": {"type": "object", "required": ["status", "basis"], "properties": {"status": {"enum": ["supplied_not_verified", "unknown", "escalate", "not_applicable"]}, "basis": {"type": "string"}}, "additionalProperties": false},
        "effects": {"type": "object", "required": ["sent", "signed", "accepted", "filed", "mutated_records"], "properties": {"sent": {"const": false}, "signed": {"const": false}, "accepted": {"const": false}, "filed": {"const": false}, "mutated_records": {"const": false}}, "additionalProperties": false},
        "rollback": {"type": "string"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "workflow_step", "status", "variables", "last_updated"],
      "properties": {"task_id": {"type": "string", "pattern": "^clo-[a-z0-9-]+$"}, "workflow_step": {"type": "string"}, "status": {"enum": ["INITIALIZED", "IN_PROGRESS", "PENDING_APPROVAL", "COMPLETED", "FAILED"]}, "variables": {"type": "object", "additionalProperties": false, "properties": {"matter_ref": {"type": "string"}, "request_digest": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "review_owner": {"type": "string"}}}, "last_updated": {"type": "string", "format": "date-time"}, "rollback": {"type": "string"}}
    }
  }
}
