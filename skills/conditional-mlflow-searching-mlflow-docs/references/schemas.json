{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_or_question",
            "scope_or_context",
            "evidence_refs",
            "backend_or_jurisdiction_state",
            "requested_work_product"
          ],
          "properties": {
            "case_or_question": {
              "type": "string",
              "description": "The exact legal or technical task question."
            },
            "scope_or_context": {
              "type": "string",
              "description": "Entity/matter or agent/backend context supplied for this task."
            },
            "evidence_refs": {
              "type": "string",
              "description": "Known evidence/document/run/source references."
            },
            "backend_or_jurisdiction_state": {
              "type": "string",
              "description": "Explicit jurisdiction or Eric-confirmed backend/version state; use unbound/unknown if absent."
            },
            "requested_work_product": {
              "type": "string",
              "description": "Requested bounded analysis, draft, query, or design artifact."
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_analysis",
            "source_and_method",
            "findings_or_proposal",
            "gaps_and_uncertainty",
            "next_owner_actions",
            "capability_status"
          ],
          "properties": {
            "task_analysis": {
              "type": "string",
              "description": "Task-specific steps and reasoning summary, without hidden reasoning."
            },
            "source_and_method": {
              "type": "string",
              "description": "Source versions, dates, evidence refs, procedure applied."
            },
            "findings_or_proposal": {
              "type": "string",
              "description": "Concrete sourced analysis, draft, findings, query result or design."
            },
            "gaps_and_uncertainty": {
              "type": "string",
              "description": "Missing facts, currentness/coverage limits and unresolved questions."
            },
            "next_owner_actions": {
              "type": "string",
              "description": "Optional separately owned review or confirmation steps."
            },
            "capability_status": {
              "type": "string",
              "description": "Which native interfaces were available, or exact reason task is conditional/unavailable."
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "completed_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
