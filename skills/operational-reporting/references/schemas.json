{
  "definitions": {
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "window", "records"],
      "properties": {
        "mode": { "type": "string", "enum": ["executive_digest", "flash_report", "no_material_change", "supervised_agent_summary", "maintenance_result", "trading_performance"] },
        "window": { "type": "string", "enum": ["morning", "evening", "custom"] },
        "records": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "status", "summary"], "properties": {
          "kind": { "type": "string", "enum": ["work", "calendar", "mail", "principal_task", "agent", "maintenance", "battery"] },
          "status": { "type": "string", "enum": ["verified_completed", "reported", "proposed", "blocked", "unknown", "attention"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "owner": { "type": "string", "maxLength": 200 }, "evidence_pointer": { "type": "string", "minLength": 1, "maxLength": 500 },
          "is_routine": { "type": "boolean" }, "is_own_mailbox": { "type": "boolean" }, "is_deadline": { "type": "boolean" }
        } } },
        "evidence": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "trading_performance": { "$ref": "#/definitions/trading_performance_input" }
      },
      "allOf": [{ "if": { "properties": { "mode": { "const": "trading_performance" } }, "required": ["mode"] }, "then": { "required": ["trading_performance"] }, "else": { "not": { "required": ["trading_performance"] } } }]
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "mode", "message", "sections", "evidence", "uncertainty", "effects"],
      "properties": {
        "status": { "type": "string", "enum": ["DRAFT", "BLOCKED", "READY_FOR_OWNER"] },
        "mode": { "type": "string", "enum": ["executive_digest", "flash_report", "no_material_change", "supervised_agent_summary", "maintenance_result", "trading_performance"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "sections": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "effects": { "type": "object", "additionalProperties": false, "required": ["messages_sent", "external_calls", "mutations"], "properties": {
          "messages_sent": { "type": "array", "maxItems": 0 }, "external_calls": { "type": "array", "maxItems": 0 }, "mutations": { "type": "array", "maxItems": 0 }
        } },
        "trading_performance": { "$ref": "#/definitions/trading_performance_output" }
      },
      "allOf": [{ "if": { "properties": { "mode": { "const": "trading_performance" } }, "required": ["mode"] }, "then": { "required": ["trading_performance"], "properties": {"evidence": {"maxItems": 20000}, "uncertainty": {"maxItems": 25000}} }, "else": { "not": { "required": ["trading_performance"] }, "properties": {"evidence": {"maxItems": 100}, "uncertainty": {"maxItems": 50}} } }]
    },
    "trading_performance_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period","base_currency","coverage","cost_coverage","equity_coverage","realized_pnl_basis","starting_equity","ending_equity","cash_flows","realized_pnl","fees","funding","unrealized_pnl_changes","closed_cohorts","evidence"],
      "properties": {
        "period": {"type": "object","additionalProperties": false,"required": ["start_inclusive","end_exclusive","timezone"],"properties": {"start_inclusive": {"type": "string","format": "date-time"},"end_exclusive": {"type": "string","format": "date-time"},"timezone": {"type": "string","minLength": 1,"maxLength": 80}}},
        "base_currency": {"type": "string","pattern": "^[A-Z]{3}$"},
        "coverage": {"type": "string","enum": ["complete","partial","unknown"]},
        "cost_coverage": {"type": "string","enum": ["complete","partial","unknown"]},
        "equity_coverage": {"type": "string","enum": ["complete","partial","unknown"]},
        "realized_pnl_basis": {"const": "gross_before_fees"},
        "starting_equity": {"type": "object","additionalProperties": false,"required": ["amount","currency","as_of","fx_to_base","fx_effective_at","fx_source","source_pointer"],"properties": {"amount": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"as_of": {"type": "string","format": "date-time"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}},
        "ending_equity": {"type": "object","additionalProperties": false,"required": ["amount","currency","as_of","fx_to_base","fx_effective_at","fx_source","source_pointer"],"properties": {"amount": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"as_of": {"type": "string","format": "date-time"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}},
        "cash_flows": {"type": "array","maxItems": 5000,"items": {"type": "object","additionalProperties": false,"required": ["flow_id","kind","occurred_at","amount","currency","fx_to_base","fx_effective_at","fx_source","source_pointer"],"properties": {"flow_id": {"type": "string","minLength": 1,"maxLength": 200},"kind": {"type": "string","enum": ["deposit","withdrawal"]},"occurred_at": {"type": "string","format": "date-time"},"amount": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}}},
        "realized_pnl": {"type": "array","maxItems": 5000,"items": {"type": "object","additionalProperties": false,"required": ["event_id","trade_id","occurred_at","amount","currency","fx_to_base","fx_effective_at","fx_source","source_pointer"],"properties": {"event_id": {"type": "string","minLength": 1,"maxLength": 200},"trade_id": {"type": "string","minLength": 1,"maxLength": 200},"occurred_at": {"type": "string","format": "date-time"},"amount": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}}},
        "fees": {"type": "array","maxItems": 5000,"items": {"type": "object","additionalProperties": false,"required": ["fee_id","occurred_at","amount","currency","fx_to_base","fx_effective_at","fx_source","deduction_basis","source_pointer"],"properties": {"fee_id": {"type": "string","minLength": 1,"maxLength": 200},"occurred_at": {"type": "string","format": "date-time"},"amount": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"deduction_basis": {"type": "string","enum": ["subtract_from_gross","already_net_of_realized_pnl","unknown"]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}}},
        "funding": {"type": "array","maxItems": 5000,"items": {"type": "object","additionalProperties": false,"required": ["funding_id","occurred_at","amount","currency","fx_to_base","fx_effective_at","fx_source","source_pointer"],"properties": {"funding_id": {"type": "string","minLength": 1,"maxLength": 200},"occurred_at": {"type": "string","format": "date-time"},"amount": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}}},
        "unrealized_pnl_changes": {"type": "array","maxItems": 5000,"items": {"type": "object","additionalProperties": false,"required": ["mark_id","trade_id","start_mark","end_mark"],"properties": {"mark_id": {"type": "string","minLength": 1,"maxLength": 200},"trade_id": {"type": "string","minLength": 1,"maxLength": 200},"start_mark": {"type": "object","additionalProperties": false,"required": ["amount","currency","as_of","fx_to_base","fx_effective_at","fx_source","source_pointer"],"properties": {"amount": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"as_of": {"type": "string","format": "date-time"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}},"end_mark": {"type": "object","additionalProperties": false,"required": ["amount","currency","as_of","fx_to_base","fx_effective_at","fx_source","source_pointer"],"properties": {"amount": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"currency": {"type": "string","pattern": "^[A-Z]{3}$"},"as_of": {"type": "string","format": "date-time"},"fx_to_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"fx_effective_at": {"oneOf": [{"type": "string","format": "date-time"},{"type": "null"}]},"fx_source": {"oneOf": [{"type": "string","minLength": 1,"maxLength": 500},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}}}}},
        "closed_cohorts": {"type": "array","maxItems": 2000,"items": {"type": "object","additionalProperties": false,"required": ["trade_id","closed_at","net_pnl_base","source_pointer","initial_risk"],"properties": {"trade_id": {"type": "string","minLength": 1,"maxLength": 200},"closed_at": {"type": "string","format": "date-time"},"net_pnl_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},{"type": "null"}]},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500},"initial_risk": {"oneOf": [{"type": "object","additionalProperties": false,"required": ["side","entry_at","entry_price","original_stop","quantity","contract_multiplier","point_value_per_price_unit_per_contract","quote_currency","fx_to_base","fx_effective_at","fx_source","price_unit","quantity_unit","source_pointer"],"properties": {"side": {"type": "string","enum": ["long","short"]},"entry_at": {"type": "string","format": "date-time"},"entry_price": {"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},"original_stop": {"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},"quantity": {"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},"contract_multiplier": {"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},"point_value_per_price_unit_per_contract": {"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},"quote_currency": {"type": "string","pattern": "^[A-Z]{3}$"},"fx_to_base": {"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 80},"fx_effective_at": {"type": "string","format": "date-time"},"fx_source": {"type": "string","minLength": 1,"maxLength": 500},"price_unit": {"type": "string","minLength": 1,"maxLength": 80},"quantity_unit": {"type": "string","minLength": 1,"maxLength": 80},"source_pointer": {"type": "string","minLength": 1,"maxLength": 500}}},{"type": "null"}]}}}},
        "evidence": {"type": "array","minItems": 1,"maxItems": 20000,"items": {"type": "string","minLength": 1,"maxLength": 500}}
      }
    },
    "trading_performance_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["division_precision","period","base_currency","coverage","cash_flow_base","realized_gross_pnl_base","fee_expense_base","funding_base","net_realized_pnl_base","unrealized_pnl_change_base","starting_equity_base","expected_ending_equity_base","observed_ending_equity_base","equity_residual_base","equity_reconciled","closed_count","known_closed_count","unknown_closed_count","closed_cohort_net_pnl_base","mean_net_pnl_per_closed_trade_base","all_closed_win_rate","decided_win_rate","profit_factor","r_by_trade","unknowns","source_pointers"],
      "properties": {
        "division_precision": {"const": "18 significant digits, ROUND_HALF_EVEN; exact numerator and denominator retained"},
        "period": {"type": "string","minLength": 1,"maxLength": 200},
        "base_currency": {"type": "string","pattern": "^[A-Z]{3}$"},
        "coverage": {"type": "string","enum": ["complete","partial","unknown"]},
        "cash_flow_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "realized_gross_pnl_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "fee_expense_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "funding_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "net_realized_pnl_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "unrealized_pnl_change_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "starting_equity_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "expected_ending_equity_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "observed_ending_equity_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "equity_residual_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "equity_reconciled": {"type": "boolean"},
        "closed_count": {"type": "integer","minimum": 0},
        "known_closed_count": {"type": "integer","minimum": 0},
        "unknown_closed_count": {"type": "integer","minimum": 0},
        "closed_cohort_net_pnl_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "mean_net_pnl_per_closed_trade_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},
        "all_closed_win_rate": {"type": "object","additionalProperties": false,"required": ["value","numerator","denominator","basis","undefined_reason"],"properties": {"value": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"numerator": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"denominator": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"basis": {"type": "string","minLength": 1,"maxLength": 300},"undefined_reason": {"oneOf": [{"type": "string","maxLength": 500},{"type": "null"}]}}},
        "decided_win_rate": {"type": "object","additionalProperties": false,"required": ["value","numerator","denominator","basis","undefined_reason"],"properties": {"value": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"numerator": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"denominator": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"basis": {"type": "string","minLength": 1,"maxLength": 300},"undefined_reason": {"oneOf": [{"type": "string","maxLength": 500},{"type": "null"}]}}},
        "profit_factor": {"type": "object","additionalProperties": false,"required": ["value","numerator","denominator","basis","undefined_reason"],"properties": {"value": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"numerator": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"denominator": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"basis": {"type": "string","minLength": 1,"maxLength": 300},"undefined_reason": {"oneOf": [{"type": "string","maxLength": 500},{"type": "null"}]}}},
        "r_by_trade": {"type": "array","maxItems": 2000,"items": {"type": "object","additionalProperties": false,"required": ["trade_id","initial_risk_base","net_pnl_base","r_multiple","undefined_reason"],"properties": {"trade_id": {"type": "string"},"initial_risk_base": {"oneOf": [{"type": "string","pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"net_pnl_base": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"r_multiple": {"oneOf": [{"type": "string","pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$","maxLength": 500},{"type": "null"}]},"undefined_reason": {"oneOf": [{"type": "string","maxLength": 500},{"type": "null"}]}}}},
        "unknowns": {"type": "array","maxItems": 25000,"items": {"type": "string","maxLength": 500}},
        "source_pointers": {"type": "array","minItems": 1,"maxItems": 20000,"uniqueItems": true,"items": {"type": "string","minLength": 1,"maxLength": 500}}
      }
    }
  }
}
