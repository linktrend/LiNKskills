{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trading-filings-insider-dilution task contract draft",
  "type": "object",
  "definitions": {
    "input": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string"
        },
        "cik": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": "string"
        },
        "filings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "accession_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "share_count_sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "xbrl_facts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ownership_filings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "market_price_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "issuer",
        "as_of"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "needs_input",
            "blocked"
          ]
        },
        "identity": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "cik": {
              "type": [
                "string",
                "null"
              ]
            },
            "as_of": {
              "type": "string"
            },
            "cik_status": {
              "enum": [
                "verified",
                "unknown"
              ]
            },
            "cik_reason": {
              "type": "string"
            }
          },
          "required": [
            "issuer",
            "cik",
            "cik_status",
            "cik_reason",
            "as_of"
          ],
          "additionalProperties": false
        },
        "filing_timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "form": {
                "type": "string"
              },
              "accepted": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interpretation": {
                "type": "string"
              },
              "accession": {
                "type": "string"
              }
            },
            "required": [
              "form",
              "accepted",
              "interpretation",
              "accession"
            ],
            "additionalProperties": false
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              },
              "unit": {
                "type": "string"
              },
              "period": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "known_at": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value",
              "unit",
              "period",
              "context",
              "known_at",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "ownership_reconciliation": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "offering_state": {
          "type": "string"
        },
        "dilution_calculation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        },
        "xbrl_fallback": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string"
            },
            "text_source": {
              "type": "null"
            }
          },
          "required": [
            "status",
            "text_source"
          ],
          "additionalProperties": false
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_handoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "identity",
        "filing_timeline",
        "facts",
        "ownership_reconciliation",
        "offering_state",
        "dilution_calculation",
        "xbrl_fallback",
        "conflicts",
        "limitations",
        "owner_handoffs",
        "gaps"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "gaps": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "in_progress",
            "completed",
            "needs_input",
            "blocked"
          ]
        },
        "open_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  }
}
