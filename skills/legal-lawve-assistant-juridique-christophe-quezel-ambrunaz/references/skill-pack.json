{
  "schema_version": "0.1",
  "skill_id": "legal-lawve-assistant-juridique-christophe-quezel-ambrunaz",
  "display_name": "French Legal Research and Authority Memo",
  "version": "0.1.0",
  "description": "Prepare a source-grounded research memo on a defined question of French law or EU law as relevant to a France-based legal question. Other source modes route to their distinct contract, proofreading, document-review or legal-monitoring tasks.",
  "capability_category": "conditional_legal_task",
  "lifecycle_state": "draft",
  "format_profile": "heavy",
  "compatible_runtime_profiles": [
    "lisa-openclaw",
    "cursor-macos"
  ],
  "min_capability_tier": "balanced",
  "provenance": {
    "author": "LiNKskills adaptation",
    "source": "lawve-ai/awesome-legal-skills@045f738df65ae53867c2f69f7e8a1e4f61816290:skills/assistant-juridique-christophe-quezel-ambrunaz/SKILL.md",
    "license": "Source declarations and all original notices preserved; no license clearance claim."
  },
  "routing": {
    "when_to_use": "Prepare a source-grounded research memo on a defined question of French law or EU law as relevant to a France-based legal question. Other source modes route to their distinct contract, proofreading, document-review or legal-monitoring tasks.",
    "when_not_to_use": [
      "A different, distinct task is requested",
      "An unapproved external effect, final decision, signature or system mutation is required"
    ],
    "tags": [
      "conditional",
      "task-specific",
      "draft"
    ],
    "exclusion_rules": [
      "Do not infer legal, company or jurisdiction applicability.",
      "No external effects, filing, signing, source-system mutation or compliance certification."
    ],
    "ambiguity_rules": [
      "Read authorized evidence; ask only materially outcome-changing questions; complete separable work"
    ],
    "recommended_disclosure_level": 2
  },
  "execution": {
    "required_inputs": [
      {
        "name": "research_question",
        "description": "One answerable legal question and requested depth."
      },
      {
        "name": "facts_and_purpose",
        "description": "User-provided facts, intended decision and material uncertainties."
      },
      {
        "name": "jurisdiction_scope",
        "description": "French law, EU law or specified relationship; do not infer."
      },
      {
        "name": "as_of_and_recency",
        "description": "Required date and currentness needs."
      },
      {
        "name": "available_sources",
        "description": "Authorized official legislation, court, regulator and secondary materials already supplied or reachable through granted native search."
      },
      {
        "name": "scope_and_as_of",
        "description": "Applicable scope and as-of date; unknown when unavailable."
      }
    ],
    "expected_outputs": [
      {
        "name": "legal-lawve-assistant-juridique-christophe-quezel-ambrunaz_work_product",
        "description": "Typed task output with evidence, gaps and owner questions."
      }
    ],
    "forbidden_actions": [
      "Unapproved external effects, signatures, filings, legal commitments or source-system mutations",
      "Inventing facts, jurisdiction, legal authority, company policy or approval",
      "Exposure of confidential or personal data outside authorized scope"
    ],
    "verification_steps": [
      "Every legal proposition has a primary source and pinpoint or is explicitly unverified.",
      "A citation is checked for content support and current status.",
      "No specific advice, jurisdiction or case fact is invented.",
      "Verify primary legal authority and as-of date or mark the proposition unverified.",
      "Keep external_effects and mutations empty."
    ],
    "completion_criteria": [
      "Task-specific output complete or exact blocker identified.",
      "Evidence, source currency and unknowns visible.",
      "No unapproved effect or mutation."
    ],
    "known_limitations": [
      "Draft/uncertified; structural validation does not prove legal accuracy or task performance.",
      "No license-compliance or legal-clearance claim.",
      "No live database, external research connector or business-system write assumed."
    ]
  },
