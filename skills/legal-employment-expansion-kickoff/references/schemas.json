{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "request_ref",
        "source_refs",
        "data_classification",
        "task_inputs"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^\\d{8}-\\d{4}-[A-Z0-9]+-\\d{6}$"
        },
        "request_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "data_classification": {
          "type": "string",
          "enum": [
            "synthetic",
            "redacted",
            "restricted",
            "sensitive",
            "unknown"
          ]
        },
        "task_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legal_employment_expansion_kickoff_task_payload",
            "task_request",
            "source_documents",
            "company_or_matter_facts",
            "jurisdiction_and_as_of",
            "approved_positions_or_policy_ref"
          ],
          "properties": {
            "task_request": {
              "type": "string",
              "minLength": 1,
              "description": "Exact requested deliverable and boundaries."
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Authorized document, record, or evidence references."
            },
            "company_or_matter_facts": {
              "type": "string",
              "minLength": 1,
              "description": "Founder-confirmed facts and company/matter context; unknowns remain explicit."
            },
            "jurisdiction_and_as_of": {
              "type": [
                "object",
                "null"
              ],
              "description": "Only actual jurisdiction(s) supplied or established from authoritative evidence, plus as-of date. Null when not applicable/known.",
              "properties": {
                "jurisdictions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "as_of_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                }
              },
              "required": [
                "jurisdictions",
                "as_of_date"
              ],
              "additionalProperties": false
            },
            "approved_positions_or_policy_ref": {
              "type": [
                "string",
                "null"
              ],
              "description": "Approved policy/playbook/position reference, if supplied; absence is not permission to invent one."
            },
            "legal_employment_expansion_kickoff_task_payload": {
              "type": "object",
              "description": "Task-specific factual inputs for legal-employment-expansion-kickoff. Each named field records verified, principal-reported, proposed, conflicting, or explicitly unknown status and supporting evidence references.",
              "additionalProperties": false,
              "required": [
                "target_jurisdictions_and_worker_model",
                "planned_timeline_and_business_activity",
                "current_company_facts_and_policy",
                "decisions_and_research_questions"
              ],
              "properties": {
                "target_jurisdictions_and_worker_model": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fact_status",
                    "value",
                    "evidence_refs"
                  ],
                  "properties": {
                    "fact_status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "principal_reported",
                        "proposed",
                        "conflicting",
                        "unknown"
                      ],
                      "description": "Explicitly distinguish source status; use unknown rather than infer."
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "target jurisdictions and worker model; null is valid when fact_status is unknown."
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Source references supporting the value; empty when unknown."
                    }
                  }
                },
                "planned_timeline_and_business_activity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fact_status",
                    "value",
                    "evidence_refs"
                  ],
                  "properties": {
                    "fact_status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "principal_reported",
                        "proposed",
                        "conflicting",
                        "unknown"
                      ],
                      "description": "Explicitly distinguish source status; use unknown rather than infer."
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "planned timeline and business activity; null is valid when fact_status is unknown."
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Source references supporting the value; empty when unknown."
                    }
                  }
                },
                "current_company_facts_and_policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fact_status",
                    "value",
                    "evidence_refs"
                  ],
                  "properties": {
                    "fact_status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "principal_reported",
                        "proposed",
                        "conflicting",
                        "unknown"
                      ],
                      "description": "Explicitly distinguish source status; use unknown rather than infer."
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "current company facts and policy; null is valid when fact_status is unknown."
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Source references supporting the value; empty when unknown."
                    }
                  }
                },
                "decisions_and_research_questions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fact_status",
                    "value",
                    "evidence_refs"
                  ],
                  "properties": {
                    "fact_status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "principal_reported",
                        "proposed",
                        "conflicting",
                        "unknown"
                      ],
                      "description": "Explicitly distinguish source status; use unknown rather than infer."
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "decisions and research questions; null is valid when fact_status is unknown."
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Source references supporting the value; empty when unknown."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "status",
        "artifact_ref",
        "evidence_refs",
        "open_questions",
        "review_owner_role",
        "external_effects",
        "mutations",
        "work_product"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed_draft",
            "needs_context",
            "escalate",
            "blocked"
          ]
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_owner_role": {
          "type": "string"
        },
        "external_effects": {
          "type": "array",
          "maxItems": 0
        },
        "mutations": {
          "type": "array",
          "maxItems": 0
        },
        "work_product": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "partial_work": {
              "type": "string",
              "minLength": 1
            },
            "missing_inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unknown_facts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "legal_employment_expansion_kickoff_work_product": {
              "type": "object",
              "additionalProperties": false,
              "description": "Task-specific output sections derived from the active method: expansion intake, fact register, jurisdiction-specific research plan, decision owners, milestones, dependencies and legal questions.",
              "properties": {
                "expansion_intake": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "content",
                    "evidence_refs",
                    "fact_status"
                  ],
                  "properties": {
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "fact_status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "principal_reported",
                        "proposed",
                        "conflicting",
                        "unknown"
                      ]
                    }
                  },
                  "description": "Section for expansion intake. Keep uncertainty explicit."
                },
                "fact_register": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "content",
                      "evidence_refs"
                    ],
                    "properties": {
                      "content": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "verified",
                          "principal_reported",
                          "proposed",
                          "conflicting",
                          "unknown"
                        ]
                      }
                    }
                  },
                  "description": "Rows/items for fact register. Use status unknown and list the missing evidence rather than infer."
                },
                "jurisdiction_specific_research_plan": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "content",
                      "evidence_refs"
                    ],
                    "properties": {
                      "content": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "verified",
                          "principal_reported",
                          "proposed",
                          "conflicting",
                          "unknown"
                        ]
                      }
                    }
                  },
                  "description": "Rows/items for jurisdiction-specific research plan. Use status unknown and list the missing evidence rather than infer."
                },
                "decision_owners": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "content",
                      "evidence_refs"
                    ],
                    "properties": {
                      "content": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "verified",
                          "principal_reported",
                          "proposed",
                          "conflicting",
                          "unknown"
                        ]
                      }
                    }
                  },
                  "description": "Rows/items for decision owners. Use status unknown and list the missing evidence rather than infer."
                },
                "milestones": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "content",
                    "evidence_refs",
                    "fact_status"
                  ],
                  "properties": {
                    "content": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "fact_status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "principal_reported",
                        "proposed",
                        "conflicting",
                        "unknown"
                      ]
                    }
                  },
                  "description": "Section for milestones. Keep uncertainty explicit."
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "content",
                      "evidence_refs"
                    ],
                    "properties": {
                      "content": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "verified",
                          "principal_reported",
                          "proposed",
                          "conflicting",
                          "unknown"
                        ]
                      }
                    }
                  },
                  "description": "Rows/items for dependencies. Use status unknown and list the missing evidence rather than infer."
                },
                "legal_questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "content",
                      "evidence_refs"
                    ],
                    "properties": {
                      "content": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "verified",
                          "principal_reported",
                          "proposed",
                          "conflicting",
                          "unknown"
                        ]
                      }
                    }
                  },
                  "description": "Rows/items for legal questions. Use status unknown and list the missing evidence rather than infer."
                },
                "evidence_trace": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_ref",
                      "location",
                      "supports"
                    ],
                    "properties": {
                      "source_ref": {
                        "type": "string"
                      },
                      "location": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "supports": {
                        "type": "string"
                      }
                    }
                  }
                },
                "jurisdiction_and_as_of": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "jurisdictions",
                    "as_of_date"
                  ],
                  "properties": {
                    "jurisdictions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "as_of_date": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date"
                    }
                  }
                },
                "assumptions_and_gaps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proposed_next_steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "expansion_intake",
                "fact_register",
                "jurisdiction_specific_research_plan",
                "decision_owners",
                "milestones",
                "dependencies",
                "legal_questions",
                "evidence_trace",
                "jurisdiction_and_as_of",
                "assumptions_and_gaps",
                "proposed_next_steps"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed_draft"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "legal_employment_expansion_kickoff_work_product"
                ],
                "properties": {
                  "legal_employment_expansion_kickoff_work_product": {
                    "required": [
                      "expansion_intake",
                      "fact_register",
                      "jurisdiction_specific_research_plan",
                      "decision_owners",
                      "milestones",
                      "dependencies",
                      "legal_questions",
                      "evidence_trace",
                      "jurisdiction_and_as_of",
                      "assumptions_and_gaps",
                      "proposed_next_steps"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_context"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "work_product": {
                "required": [
                  "partial_work",
                  "missing_inputs",
                  "unknown_facts"
                ]
              }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "phase",
        "status",
        "checkpoint_ref",
        "updated_at"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "intake",
            "evidence",
            "analysis",
            "draft",
            "quality_check",
            "delivered"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "waiting_for_input",
            "completed_draft",
            "blocked"
          ]
        },
        "checkpoint_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference from consumer-owner supported checkpoint interface; never write local JSONL runtime state."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
