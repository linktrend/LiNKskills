{
  "schema_version": "0.1",
  "kind": "linkskills.pkt-25.package-receipt",
  "status": "LOCAL_ONLY",
  "identity": {
    "repository": "<owner/repository>",
    "ref": "<refs/heads/exact-ref>",
    "commit": "<40-char-source-commit>",
    "tree": "<40-char-source-tree>",
    "package_id": "<family/name>",
    "package_version": "<immutable-version>",
    "package_sha256": "<64-char-package-digest>",
    "manifest_sha256": "<64-char-manifest-digest>"
  },
  "identity_binding": {"status": "NOT_RUN", "source_only": true, "external_provider_contacted": false},
  "source_binding": {"status": "NOT_RUN", "fields": ["repository", "ref", "commit", "tree"], "checkout": null, "provider": null},
  "rehearsal": {"fixture_sha256": null, "command_or_profile_digest": null, "result_sha256": null, "rollback_ref": null, "handoff_ref": null},
  "receipt_ref": null,
  "receipt_digest": null,
  "receipt_sha256": null,
  "claims": {"provider_live": false, "consumer_configured": false, "stage_proven": false, "vps_proven": false, "e2e_proven": false, "production_proven": false}
}
